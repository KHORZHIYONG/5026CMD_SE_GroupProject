<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS Staff</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f4f7f6;
                margin: 0;
                overflow-x: hidden;
                display: flex;
            }

            .sidebar {
                width: 240px;
                background-color: #121418;
                min-height: 100vh;
                color: #fff;
                position: fixed;
                display: flex;
                flex-direction: column;
            }

            .sidebar-header {
                padding: 20px;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 10px;
            }

            .sidebar-brand-text {
                font-size: 1.6rem;
                font-weight: 700;
                margin: 0;
                background: linear-gradient(135deg, #e85d04, #fca311);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .sidebar-tagline {
                font-size: 0.8rem;
                color: #a0aec0;
            }

            .nav-link {
                color: #a0aec0;
                padding: 12px 25px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                transition: all 0.2s;
            }

                .nav-link:hover, .nav-link.active {
                    color: #ffffff;
                    background: rgba(255, 255, 255, 0.05);
                    border-left: 4px solid #e85d04;
                }

            .main-content {
                margin-left: 240px;
                flex-grow: 1;
                padding: 30px;
                width: calc(100% - 240px);
                min-height: 100vh;
            }

            .page-title {
                font-size: 1.8rem;
                font-weight: 700;
                color: #2d3748;
                margin: 0;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand-text">ResROMS</div>
            <div class="sidebar-tagline">Staff Portal</div>
        </div>

        <a href="/Staff/Profile" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Profile" ? "active" : "")">
            <i class="bi bi-person-circle"></i> My Profile
        </a>
        <a href="/Staff/Reservations" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Reservations" ? "active" : "")">
            <i class="bi bi-calendar-check"></i> Reservations
        </a>
        <a href="/Staff/Orders" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Orders" ? "active" : "")">
            <i class="bi bi-list-check"></i> Orders
        </a>
        <a href="/Staff/Billing" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Billing" ? "active" : "")">
            <i class="bi bi-receipt"></i> Billing
        </a>
        <a href="/Staff/Customers" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Staff/Customers" ? "active" : "")">
            <i class="bi bi-people"></i> Customers
        </a>

        <div style="margin-top: auto; padding-bottom: 20px;">
            <div class="px-4 pb-2 small text-secondary">
                <i class="bi bi-person-badge me-1"></i>@(User.Identity?.Name ?? "Staff")
                <div>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
            </div>
            @* Sign out must be a POST so the server can end the login cookie safely. *@
            <form method="post" asp-page="/Logout" class="m-0">
                <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start">
                    <i class="bi bi-box-arrow-left"></i> Sign Out
                </button>
            </form>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>