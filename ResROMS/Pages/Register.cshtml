@page "/Register"
@model ResROMS.Pages.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create account - ResROMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f4f7f6; }
        .card-box { max-width: 480px; margin: 5vh auto; background: #fff; border-radius: 18px; box-shadow: 0 5px 24px rgba(0,0,0,.06); padding: 2rem; }
        .brand { font-weight: 700; color: #e85d04; font-size: 1.8rem; }
        .primary-action { background: #e85d04; color: #fff; border: none; }
        .primary-action:hover { background: #c74d00; color: #fff; }
    </style>
</head>
<body>
    <div class="card-box">
        <div class="brand mb-1">ResROMS</div>
        <h1 class="h4 fw-bold mb-3">Create your customer account</h1>

        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Phone" class="form-label">Phone (optional)</label>
                <input asp-for="Input.Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 12 characters.</div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn primary-action w-100 fw-bold">Create account</button>
        </form>
        <p class="text-center small mt-3 mb-0">Already registered? <a href="/Login">Sign in</a></p>
    </div>
</body>
</html>
