@page
@model ResROMS.Pages.AssistantModel
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout"
        : (User.IsInRole("Waiter") || User.IsInRole("Kitchen Staff") || User.IsInRole("Staff"))
            ? "/Pages/Staff/_StaffLayout.cshtml" : "_CustomerLayout";
    ViewData["Title"] = "AI Assistant";
    var isAdmin = User.IsInRole("Admin");
}
@section Styles {
  <style>
    .rr-chat-page { background:radial-gradient(circle at top left,#ffebde 0%,transparent 45%),#f6f8fc; border-radius:22px; }
    /* Customer layout also has a separate rules-based floating helper. Hide it on the full AI page. */
    .chat-fab, .chat-box { display:none!important; }
    .rr-page-nav { max-width:1250px; margin:auto; padding:25px 26px 10px; display:flex; justify-content:space-between; align-items:center; gap:15px; }
    .rr-page-logo { color:#233044; text-decoration:none; font-weight:850; font-size:1.06rem; }
    .rr-page-logo strong { color:#d85820; }
    .rr-back { border:1px solid #dce3ec; color:#41506a; text-decoration:none; border-radius:10px; background:white;
      font-size:.85rem; padding:9px 13px; }
    .rr-back:hover { border-color:#d85820; color:#ba451a; }
    .rr-chat-page { max-width:1400px; margin:0 auto; padding:18px 26px 35px; display:grid; grid-template-columns:minmax(250px,360px) minmax(0,1fr); gap:25px; align-items:start; }
    .rr-page-intro { padding:22px 10px; }
    .rr-eyebrow { color:#c04b1b; font-size:.78rem; font-weight:850; text-transform:uppercase; letter-spacing:.1em; }
    .rr-page-heading { font-size:clamp(2rem,3.2vw,3.1rem); font-weight:830; letter-spacing:-.035em; line-height:1.13; margin:13px 0 18px; }
    .rr-page-highlight { color:#df6226; }
    .rr-page-lead { font-size:1rem; line-height:1.65; color:#596981; max-width:36ch; }
    .rr-page-feature { display:flex; align-items:flex-start; gap:12px; margin-top:24px; color:#42536b; font-size:.88rem; line-height:1.45; }
    .rr-page-feature i { color:#d75c20; background:#fff1e8; border-radius:9px; width:32px; height:32px; display:grid; place-items:center; flex:none; }
    .rr-page-note { margin-top:33px; font-size:.78rem; line-height:1.55; color:#748093; }
    .rr-chat-widget.rr-standalone { position:static; width:100%; max-width:none; z-index:auto; }
    .rr-chat-widget.rr-standalone .rr-chat-panel { display:flex!important; width:100%; height:min(78vh,820px); min-height:520px; position:static;
      box-shadow:0 25px 70px #2538521d; border-radius:19px; }
    .rr-chat-widget.rr-standalone .rr-chat-launcher, .rr-chat-widget.rr-standalone .rr-chat-close,
    .rr-chat-widget.rr-standalone a[href="/Assistant"] { display:none; }
    @@media(max-width:800px) { .rr-chat-page { grid-template-columns:1fr; padding:10px 14px 25px; gap:8px; }
      .rr-page-intro { padding:12px 5px; } .rr-page-heading { margin:7px 0 10px; font-size:2rem; }
      .rr-page-feature,.rr-page-note { display:none; } .rr-chat-widget.rr-standalone .rr-chat-panel { height:76vh;min-height:490px; }
      .rr-page-nav { padding:15px 15px 5px; } }
  </style>
}
<div class="rr-page-nav" aria-label="Page heading">
  <span class="rr-page-logo"><i class="bi bi-shop me-2" aria-hidden="true"></i>Res<strong>ROMS</strong> AI Assistant</span>
  <a href="@(isAdmin ? "/Admin/Dashboard" : User.IsInRole("Customer") ? "/Customer/Dashboard" : "/Staff/Orders")" class="rr-back"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to Dashboard</a>
</div>
  <section class="rr-chat-page" aria-label="Restaurant AI assistant">
    <div class="rr-page-intro">
      <div class="rr-eyebrow"><i class="bi bi-stars me-1" aria-hidden="true"></i> AI-powered assistance</div>
      <h1 class="rr-page-heading">@(isAdmin ? "Meet your" : "Your restaurant")<br/><span class="rr-page-highlight">@(isAdmin ? "Business Copilot." : "assistant.")</span></h1>
      <p class="rr-page-lead">@(isAdmin
          ? "Explore your most ordered dishes, discover low-cost promotional ideas and ask questions about your restaurant—all from one place."
          : "Explore available dishes, find opening hours and learn how to make a reservation.")</p>
      @if (isAdmin)
      {
        <div class="rr-page-feature"><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span><strong>Real order insights</strong><br/>Top dishes and recent trends from actual records, excluding cancelled orders.</span></div>
        <div class="rr-page-feature"><i class="bi bi-lightbulb" aria-hidden="true"></i><span><strong>Practical marketing support</strong><br/>Ideas for campaigns, social media and making better use of menu favorites.</span></div>
        <div class="rr-page-feature"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Admin-only metrics</strong><br/>Aggregated statistics are shown to Admins; private customer records are never sent.</span></div>
      }
      else
      {
        <div class="rr-page-feature"><i class="bi bi-journal-text" aria-hidden="true"></i><span><strong>Menu guide</strong><br/>Learn more about what's on the menu.</span></div>
        <div class="rr-page-feature"><i class="bi bi-calendar2-check" aria-hidden="true"></i><span><strong>Reservations</strong><br/>Get pointed toward the booking workflow.</span></div>
      }
      <p class="rr-page-note">AI advice is informational, not a guarantee of results. Verify important decisions using Admin Reports. The assistant cannot modify your restaurant records.</p>
    </div>
    <div>
      @await Html.PartialAsync("_RestaurantAiChat")
    </div>
  </section>
@section Scripts {
  <script>
    const rrFull = document.getElementById('rrRestaurantChat');
    rrFull.classList.add('rr-standalone');
    document.getElementById('rrRestaurantChatPanel').hidden = false;
    document.getElementById('rrRestaurantChatToggle').setAttribute('aria-expanded','true');
  </script>
}
