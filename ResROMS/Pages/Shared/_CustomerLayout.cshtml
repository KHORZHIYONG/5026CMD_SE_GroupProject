@using ResROMS.Services.CustomerSide
@inject ResROMS.Data.AppDbContext Db
@{
    var current = ViewContext.RouteData.Values["page"]?.ToString();
    string Active(string page) => current == page ? "active" : "";
    var uid = User.GetCustomerId();
    var seen = CustomerNotificationFeed.ReadSeen(Context.Request, uid);
    var unread = (await CustomerNotificationFeed.BuildAsync(Db, uid)).Count(n => n.WhenUtc > seen);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ResROMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Outfit', sans-serif; background: #f4f7f6; color: #26303b; }
        .topbar { background: #121418; }
        .brand { font-weight: 700; color: #ff9e5f; text-decoration: none; font-size: 1.35rem; }
        .topbar .nav-link { color: #cbd5e0; font-weight: 500; padding: .5rem .8rem; }
        .topbar .nav-link:hover, .topbar .nav-link.active { color: #fff; }
        .topbar .nav-link.active { border-bottom: 2px solid #e85d04; }
        .panel { background: #fff; border: 0; border-radius: 18px; box-shadow: 0 5px 24px rgba(0,0,0,.045); padding: 1.5rem; }
        .primary-action { background: #e85d04; color: #fff; border: none; }
        .primary-action:hover { background: #c74d00; color: #fff; }
        .page-title { font-weight: 700; }
        .price { color: #e85d04; font-weight: 700; }
        .food-img { position: relative; height: 150px; background: #edf2f7; border-radius: 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #a0aec0; font-size: 2.2rem; margin-bottom: 12px; }
        .food-img.sm { width: 64px; height: 64px; flex: 0 0 64px; margin: 0; font-size: 1.5rem; }
        .food-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .chat-fab { position: fixed; right: 24px; bottom: 24px; width: 56px; height: 56px; border-radius: 50%; border: none; background: linear-gradient(135deg,#e85d04,#fca311); color: #fff; font-size: 1.5rem; box-shadow: 0 8px 20px rgba(0,0,0,.25); z-index: 1100; }
        .chat-box { position: fixed; right: 24px; bottom: 92px; width: 340px; max-width: calc(100vw - 32px); height: 440px; background: #fff; border-radius: 14px; box-shadow: 0 12px 40px rgba(0,0,0,.25); display: none; flex-direction: column; overflow: hidden; z-index: 1100; }
        .chat-box.open { display: flex; }
        .chat-head { background: #121418; color: #fff; padding: 12px 16px; font-weight: 600; }
        .chat-msgs { flex: 1; overflow-y: auto; padding: 12px; background: #f7fafc; }
        .msg { max-width: 85%; padding: 8px 12px; border-radius: 12px; margin-bottom: 8px; white-space: pre-line; font-size: .9rem; }
        .msg.bot { background: #fff; border: 1px solid #e2e8f0; }
        .msg.me { background: #e85d04; color: #fff; margin-left: auto; }
        .chat-form { display: flex; border-top: 1px solid #e2e8f0; }
        .chat-form input { flex: 1; border: none; padding: 12px; outline: none; }
        .chat-form button { border: none; background: #121418; color: #fff; padding: 0 16px; }
        .chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 12px; background: #f7fafc; }
        .chips button { border: 1px solid #cbd5e0; background: #fff; border-radius: 14px; font-size: .75rem; padding: 3px 10px; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <nav class="container d-flex flex-wrap align-items-center gap-2 py-2">
            <a href="/Customer/Dashboard" class="brand me-3">ResROMS</a>
            <ul class="nav flex-wrap me-auto">
                <li class="nav-item"><a class="nav-link @Active("/Customer/Dashboard")" href="/Customer/Dashboard">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Menu")" href="/Customer/Menu">Menu</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Reservations")" href="/Customer/Reservations">Reservations</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Order")" href="/Customer/Order">Order</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Orders")" href="/Customer/Orders">My Orders</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/History")" href="/Customer/History">History</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Feedback")" href="/Customer/Feedback">Feedback</a></li>
                <li class="nav-item"><a class="nav-link" href="/Assistant">AI Assistant</a></li>
                <li class="nav-item"><a class="nav-link @Active("/Customer/Notifications")" href="/Customer/Notifications"><i class="bi bi-bell"></i>@if (unread > 0) { <span class="badge rounded-pill text-bg-danger ms-1">@unread</span> }</a></li>
            </ul>
            <div class="d-flex align-items-center gap-2">
                <a href="/Customer/Profile" class="btn btn-sm btn-outline-light"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</a>
                <form method="post" asp-page="/Logout" class="m-0"><button type="submit" class="btn btn-sm btn-outline-light">Sign out</button></form>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- Restaurant assistant (rule-based chatbot) -->
    <button class="chat-fab" id="chatFab" title="Ask the assistant"><i class="bi bi-chat-dots-fill"></i></button>
    <div class="chat-box" id="chatBox">
        <div class="chat-head">ResROMS Assistant</div>
        <div class="chat-msgs" id="chatMsgs">
            <div class="msg bot">Hi! I can help with the menu, reservations, opening hours, payments and your order status.</div>
        </div>
        <div class="chips">
            <button type="button" data-q="What's popular?">Popular</button>
            <button type="button" data-q="Vegetarian options">Vegetarian</button>
            <button type="button" data-q="How do I book a table?">Book a table</button>
            <button type="button" data-q="Opening hours">Hours</button>
        </div>
        <form class="chat-form" id="chatForm">
            <input id="chatInput" placeholder="Type a question..." autocomplete="off" maxlength="200" />
            <button type="submit"><i class="bi bi-send"></i></button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const box = document.getElementById('chatBox'), msgs = document.getElementById('chatMsgs'), input = document.getElementById('chatInput');
            document.getElementById('chatFab').addEventListener('click', () => box.classList.toggle('open'));
            function add(text, who) {
                const d = document.createElement('div');
                d.className = 'msg ' + who;
                d.textContent = text;   // textContent: user input is never treated as HTML
                msgs.appendChild(d);
                msgs.scrollTop = msgs.scrollHeight;
            }
            async function ask(q) {
                add(q, 'me');
                try {
                    const res = await fetch('/Customer/Chat?q=' + encodeURIComponent(q));
                    add((await res.json()).reply, 'bot');
                } catch (e) { add('Sorry, I could not reach the server.', 'bot'); }
            }
            document.getElementById('chatForm').addEventListener('submit', e => {
                e.preventDefault();
                const q = input.value.trim();
                if (q) { input.value = ''; ask(q); }
            });
            document.querySelectorAll('.chips button').forEach(b => b.addEventListener('click', () => ask(b.dataset.q)));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
