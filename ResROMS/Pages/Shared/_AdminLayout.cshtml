<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS</title>

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Google Fonts: Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            /* --- Global & Layout Styles --- */
            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f4f7f6;
                margin: 0;
                overflow-x: hidden;
                display: flex;
            }

            /* Sidebar Styling */
            .sidebar {
                width: 260px;
                background-color: #121418;
                min-height: 100vh;
                color: #fff;
                position: fixed;
                display: flex;
                flex-direction: column;
                z-index: 1000;
            }

            .sidebar-brand {
                padding: 20px;
                font-size: 1.8rem;
                font-weight: 700;
                text-align: center;
                background: linear-gradient(135deg, #e85d04, #fca311);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 20px;
            }

            .nav-link {
                color: #a0aec0;
                padding: 12px 25px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                transition: all 0.2s;
            }

                .nav-link:hover, .nav-link.active {
                    color: #ffffff;
                    background: rgba(255, 255, 255, 0.05);
                    border-left: 4px solid #e85d04;
                }

                .nav-link i {
                    font-size: 1.2rem;
                }

            /* Main Content Wrapper */
            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 30px;
                width: calc(100% - 260px);
            }

            /* Page Titles used across Admin pages */
            .page-title {
                font-size: 1.8rem;
                font-weight: 700;
                color: #2d3748;
                margin: 0;
            }
    </style>

    <!-- Render specific styles from individual pages -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar Navigation -->
    <nav class="sidebar">
        <div class="sidebar-brand">ResROMS</div>
        <!-- Note: In a real app, you'd use a small C# helper here to dynamically add the 'active' class based on the current URL -->
        <a href="/Admin/Dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
        <a href="/Admin/RestaurantInfo" class="nav-link"><i class="bi bi-shop"></i> Restaurant Setup</a>
        <a href="/Admin/Tables" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Tables" ? "active" : "")">
            <i class="bi bi-diagram-3"></i> <span class="nav-text">Tables & Layout</span>
        </a>
        <a href="/Admin/Accounts" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Accounts" ? "active" : "")">
            <i class="bi bi-people-fill"></i> <span class="nav-text">Accounts</span>
        </a>
        <a href="/Admin/Menu" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Menu" ? "active" : "")">
            <i class="bi bi-journal-richtext"></i> <span class="nav-text">Menu & Pricing</span>
        </a>
        <a href="/Admin/Orders" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Orders" ? "active" : "")">
            <i class="bi bi-list-check"></i> <span class="nav-text">Live Orders</span>
        </a>
        <a href="#" class="nav-link"><i class="bi bi-activity"></i> Live Monitor</a>
        <a href="#" class="nav-link"><i class="bi bi-bar-chart-fill"></i> Reports</a>
        <a href="/Admin/Campaigns" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Campaigns" ? "active" : "")">
            <i class="bi bi-megaphone"></i> <span class="nav-text">Campaigns</span>
        </a>

        <div style="margin-top: auto; padding-bottom: 20px;">
            <a href="/Login" class="nav-link"><i class="bi bi-box-arrow-left"></i> Sign Out</a>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Global Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Render specific scripts from individual pages -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>