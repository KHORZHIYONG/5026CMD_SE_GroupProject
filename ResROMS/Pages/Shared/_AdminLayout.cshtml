@{
    // A UI preference key scoped to the signed-in account (no credentials stored).
    var sidebarStorageKey = "ResROMS.Admin.Sidebar." +
        (User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "unknown");
}
<!DOCTYPE html>
<html lang="en" data-sidebar-storage-key="@sidebarStorageKey">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS</title>

    <!-- Restore the stored layout state before any CSS or content paints. -->
    <script>
        (() => {
            const root = document.documentElement;
            root.classList.add('sidebar-initializing');
            try {
                if (localStorage.getItem(root.dataset.sidebarStorageKey) === 'collapsed') {
                    root.classList.add('sidebar-collapsed');
                }
            } catch {
                // Storage can be disabled in some browser modes; use the expanded default.
            }
        })();
    </script>

    <!-- Base Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Core Layout CSS -->
    <style>
            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f4f7f6;
                margin: 0;
                overflow-x: hidden;
                display: flex;
            }

            /* Sidebar - Added transition and nowrap */
            .sidebar {
                width: 260px;
                background-color: #121418;
                min-height: 100vh;
                color: #fff;
                position: fixed;
                display: flex;
                flex-direction: column;
                z-index: 1000;
                transition: width 0.3s ease;
                white-space: nowrap;
            }

                /* The HTML class is available BEFORE the sidebar is painted. */
                html.sidebar-collapsed .sidebar,
                .sidebar.collapsed {
                    width: 80px;
                }

                    html.sidebar-collapsed .sidebar .sidebar-brand-text,
                    html.sidebar-collapsed .sidebar .nav-text,
                    .sidebar.collapsed .sidebar-brand-text,
                    .sidebar.collapsed .nav-text {
                        display: none;
                    }

                    html.sidebar-collapsed .sidebar .nav-link,
                    .sidebar.collapsed .nav-link {
                        justify-content: center;
                        padding: 12px 0;
                    }

                        html.sidebar-collapsed .sidebar .nav-link i,
                        .sidebar.collapsed .nav-link i {
                            font-size: 1.5rem;
                            margin: 0;
                        }

            /* Sidebar Header & Toggle Button */
            .sidebar-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 20px;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 20px;
            }

            .sidebar-brand-text {
                font-size: 1.8rem;
                font-weight: 700;
                margin: 0;
                background: linear-gradient(135deg, #e85d04, #fca311);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .toggle-btn {
                background: transparent;
                border: none;
                color: #a0aec0;
                font-size: 1.5rem;
                cursor: pointer;
                transition: color 0.2s;
                padding: 0;
            }

                .toggle-btn:hover {
                    color: #fff;
                }

            /* Nav Links */
            .nav-link {
                color: #a0aec0;
                padding: 12px 25px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                transition: all 0.2s;
            }

                .nav-link:hover, .nav-link.active {
                    color: #ffffff;
                    background: rgba(255, 255, 255, 0.05);
                    border-left: 4px solid #e85d04;
                }

                .nav-link i {
                    font-size: 1.2rem;
                }

            /* Main Content Wrapper - Added transition */
            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 30px;
                width: calc(100% - 260px);
                min-height: 100vh;
                transition: margin-left 0.3s ease, width 0.3s ease;
            }

                /* Main Content Expanded State (when sidebar is collapsed) */
                html.sidebar-collapsed .main-content,
                .main-content.expanded {
                    margin-left: 80px;
                    width: calc(100% - 80px);
                }

            /* Never animate the state restoration during page navigation. */
            html.sidebar-initializing .sidebar,
            html.sidebar-initializing .main-content {
                transition: none !important;
            }

            @@media (prefers-reduced-motion: reduce) {
                .sidebar, .main-content {
                    transition: none !important;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Sidebar Navigation -->
    <nav class="sidebar" id="mainSidebar">

        <!-- Header with Brand and Toggle -->
        <div class="sidebar-header">
            <div class="sidebar-brand-text">ResROMS</div>
            <button class="toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <!-- Navigation Links (Notice the span tags around the text) -->
        <a href="/Admin/Dashboard" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Dashboard" ? "active" : "")">
            <i class="bi bi-grid-1x2-fill"></i> <span class="nav-text">Dashboard</span>
        </a>
        <a href="/Admin/RestaurantInfo" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/RestaurantInfo" ? "active" : "")">
            <i class="bi bi-shop"></i> <span class="nav-text">Restaurant Setup</span>
        </a>
        <a href="/Admin/Tables" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Tables" ? "active" : "")">
            <i class="bi bi-diagram-3"></i> <span class="nav-text">Tables & Layout</span>
        </a>
        <a href="/Admin/Menu" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Menu" ? "active" : "")">
            <i class="bi bi-journal-richtext"></i> <span class="nav-text">Menu & Pricing</span>
        </a>
        <a href="/Admin/Accounts" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Accounts" ? "active" : "")">
            <i class="bi bi-people-fill"></i> <span class="nav-text">Accounts</span>
        </a>
        <a href="/Admin/StaffScheduling" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/StaffScheduling" ? "active" : "")">
            <i class="bi bi-calendar-week"></i> <span class="nav-text">Staff Scheduling</span>
        </a>
        <a href="/Admin/Reservations" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Reservations" ? "active" : "")">
            <i class="bi bi-calendar-check"></i> <span class="nav-text">Reservations</span>
        </a>
        <a href="/Admin/Orders" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Orders" ? "active" : "")">
            <i class="bi bi-list-check"></i> <span class="nav-text">Live Orders</span>
        </a>
        <a href="/Admin/Payments" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Payments" ? "active" : "")">
            <i class="bi bi-credit-card-2-front"></i> <span class="nav-text">Payments</span>
        </a>
        <a href="/Admin/Reports" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Reports" ? "active" : "")"><i class="bi bi-bar-chart-fill"></i> <span class="nav-text">Reports</span></a>
        <a href="/Admin/Campaigns" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Campaigns" ? "active" : "")">
            <i class="bi bi-megaphone"></i> <span class="nav-text">Campaigns</span>
        </a>

        <a href="/Admin/Feedback" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/Feedback" ? "active" : "")">
            <i class="bi bi-star-half"></i> <span class="nav-text">Customer Feedback</span>
        </a>
        <a href="/Admin/Announcements" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() is "/Admin/Announcements" or "/Announcements" ? "active" : "")">
            <i class="bi bi-bell-fill"></i> <span class="nav-text">Announcements</span>
        </a>
        <a href="/Assistant" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Assistant" ? "active" : "")" title="AI restaurant assistant">
            <i class="bi bi-chat-square-dots"></i> <span class="nav-text">AI Assistant</span>
        </a>
        <a href="/Admin/SystemSettings" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Admin/SystemSettings" ? "active" : "")">
            <i class="bi bi-sliders"></i> <span class="nav-text">System Settings</span>
        </a>

        <div class="px-3 pt-3 mt-auto border-top border-secondary border-opacity-25 admin-identity" title="Signed in Administrator">
            <span class="nav-text d-block text-white text-truncate fw-semibold">@User.Identity?.Name</span>
            <span class="nav-text text-warning small fw-semibold">Administrator</span>
        </div>
        <div style="padding-bottom: 20px;">
            <form method="post" asp-page="/Logout" class="m-0">
                <button type="submit" class="nav-link w-100 border-0 bg-transparent text-start">
                    <i class="bi bi-box-arrow-left"></i> <span class="nav-text">Sign Out</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- POST-only idle sign-out. The Razor form tag helper supplies an anti-forgery token. -->
    <form method="post" asp-page="/Logout" id="idleLogoutForm" hidden></form>

    <!-- Main Body injected from child pages -->
    <main class="main-content" id="mainContent">
        @RenderBody()
    </main>

    @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Assistant")
    {
        @await Html.PartialAsync("_RestaurantAiChat")
    }

    <!-- Base Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- JavaScript for Sidebar Toggle -->
    <script>
            (() => {
                const sidebar = document.getElementById('mainSidebar');
                const content = document.getElementById('mainContent');
                const toggle = document.getElementById('sidebarToggle');
                // The <head> restored the state already. Synchronize controls with it.
                const root = document.documentElement;
                const storageKey = root.dataset.sidebarStorageKey;
                const setCollapsed = collapsed => {
                    root.classList.toggle('sidebar-collapsed', collapsed);
                    sidebar.classList.toggle('collapsed', collapsed);
                    content.classList.toggle('expanded', collapsed);
                    toggle.setAttribute('aria-expanded', String(!collapsed));
                    toggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
                };
                setCollapsed(root.classList.contains('sidebar-collapsed'));
                // Allow transitions only after the initial layout has been drawn.
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => root.classList.remove('sidebar-initializing'));
                });
                toggle.addEventListener('click', () => {
                    const collapsed = !root.classList.contains('sidebar-collapsed');
                    setCollapsed(collapsed);
                    try { localStorage.setItem(storageKey, collapsed ? 'collapsed' : 'expanded'); } catch { }
                });
            })();
    </script>

    <!-- Administrator inactivity control. Server-side cookie expiration is authoritative. -->
    <script>
        (() => {
            const idleLimitMs = 15 * 60 * 1000;
            const keepAliveIntervalMs = 4 * 60 * 1000;
            const recentActivityMs = 60 * 1000;
            const activityKey = 'ResROMS.Admin.LastActivity';
            const logoutForm = document.getElementById('idleLogoutForm');
            let lastActivity = Date.now();
            let lastStoredActivity = 0;
            let lastKeepAlive = Date.now();
            let signingOut = false;
            let pingInProgress = false;

            // Only an activity timestamp is shared between tabs. Never store a token.
            const readLastActivity = () => {
                try {
                    const stored = Number(localStorage.getItem(activityKey));
                    return Math.max(lastActivity, Number.isFinite(stored) ? stored : 0);
                } catch {
                    return lastActivity;
                }
            };

            const recordActivity = () => {
                if (signingOut) return;
                const now = Date.now();
                lastActivity = now;
                if (now - lastStoredActivity >= 10000) {
                    try { localStorage.setItem(activityKey, String(now)); } catch { /* disabled storage */ }
                    lastStoredActivity = now;
                }
            };

            const signOutDueToInactivity = () => {
                if (signingOut) return;
                signingOut = true;
                // POST carries the antiforgery token and ends the cookie session.
                logoutForm.requestSubmit();
            };

            const checkSession = async () => {
                if (pingInProgress || signingOut) return;
                pingInProgress = true;
                try {
                    const response = await fetch('/auth/keepalive', {
                        method: 'GET',
                        credentials: 'same-origin',
                        cache: 'no-store',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (response.redirected || !response.ok) {
                        window.location.replace('/Login');
                    }
                } catch {
                    // Offline or network error: do not invent a logout result.
                    // The server will still check the cookie at the next request.
                } finally {
                    pingInProgress = false;
                }
            };

            ['pointerdown', 'keydown', 'scroll', 'touchstart', 'mousemove'].forEach(eventName => {
                document.addEventListener(eventName, recordActivity, { passive: true });
            });

            recordActivity();
            window.setInterval(() => {
                const now = Date.now();
                const latestActivity = readLastActivity();
                if (now - latestActivity >= idleLimitMs) {
                    signOutDueToInactivity();
                    return;
                }
                // Keep an actively used page alive even if no form was submitted.
                // Passive/idle tabs do not send renewal requests by themselves.
                if (now - latestActivity <= recentActivityMs &&
                    now - lastKeepAlive >= keepAliveIntervalMs) {
                    lastKeepAlive = now;
                    void checkSession();
                }
            }, 15000);

            // Revalidate if the browser restores an older page from back/forward cache.
            window.addEventListener('pageshow', (event) => {
                if (event.persisted) {
                    if (Date.now() - readLastActivity() >= idleLimitMs) {
                        signOutDueToInactivity();
                    } else {
                        void checkSession();
                    }
                }
            });
        })();
    </script>

    <!-- Page-Specific Scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>