@page "/Customer/Reservations"
@using ResROMS.Services
@model ResROMS.Pages.Customer.ReservationsModel
@{
    Layout = null;
    ViewData["Title"] = "My Reservations";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My Reservations - ResROMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {font-family:'Outfit',sans-serif;background:#f4f7f6;color:#26303b}
        .topbar {background:#121418;color:#fff}
        .brand {font-weight:700;color:#ff9e5f;text-decoration:none;font-size:1.35rem}
        .panel {background:#fff;border:0;border-radius:18px;box-shadow:0 5px 24px rgba(0,0,0,.045);padding:1.5rem}
        .primary-action {background:#e85d04;color:#fff;border:none}.primary-action:hover {background:#c74d00;color:#fff}
        .pill {font-size:.76rem;font-weight:700;border-radius:20px;padding:.3rem .75rem}
        .pill-Pending {background:#fff3cd;color:#735200}.pill-Confirmed {background:#d1fae5;color:#065f46}
        .pill-Completed {background:#dbeafe;color:#1e40af}.pill-Cancelled {background:#f3f4f6;color:#4b5563}
        .form-label {font-weight:600}
    </style>
</head>
<body>
    <header class="topbar py-3">
        <div class="container d-flex align-items-center justify-content-between gap-3">
            <a href="/Customer/Reservations" class="brand">ResROMS</a>
            <div class="d-flex align-items-center gap-3">
                <a href="/Announcements" class="btn btn-sm btn-outline-light">Announcements</a>
                <span class="small">Hello, @Model.CustomerName</span>
                <form method="post" asp-page="/Logout" class="m-0"><button type="submit" class="btn btn-sm btn-outline-light">Sign out</button></form>
            </div>
        </div>
    </header>
    <main class="container py-5">
        <div class="mb-4">
            <h1 class="fw-bold">My Reservations</h1>
            <p class="text-muted">Book a table and track your confirmation. All displayed times are Malaysia time (MYT).</p>
        </div>
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success" role="alert">@success</div>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <div class="row g-4">
            <div class="col-lg-5">
                <section class="panel">
                    <h2 class="h4 fw-bold mb-3"><i class="bi bi-calendar-plus me-2"></i>Reserve a Table</h2>
                    @if (Model.Tables.Count == 0)
                    {
                        <div class="alert alert-warning">Table booking is not available yet. Please contact the restaurant.</div>
                    }
                    @if (!Model.CustomerBookingsEnabled)
                    {
                        <div class="alert alert-warning">Online reservation requests are temporarily paused. Existing reservations remain visible and can still be cancelled.</div>
                    }
                    @if (Model.CustomerBookingsEnabled)
                    {
                    <form method="post" asp-page-handler="Create" id="newBookingForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="NewBooking.StartLocal" class="form-label">Date &amp; time (MYT)</label>
                                <input asp-for="NewBooking.StartLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" step="900" class="form-control" required />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="NewBooking.DurationMinutes" class="form-label">Dining duration</label>
                                <select asp-for="NewBooking.DurationMinutes" class="form-select">
                                    @foreach (var minutes in new[] { 30, 60, 90, 120, 150, 180, 210, 240 })
                                    {
                                        <option value="@minutes">@minutes minutes</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="NewBooking.PartySize" class="form-label">Guests</label>
                                <input asp-for="NewBooking.PartySize" type="number" min="1" max="20" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <button type="button" id="checkAvailability" class="btn btn-outline-dark w-100">Check table availability</button>
                            </div>
                            <div class="col-12">
                                <label asp-for="NewBooking.TableId" class="form-label">Select table</label>
                                <select asp-for="NewBooking.TableId" id="availableTables" class="form-select" required>
                                    <option value="">Choose a table</option>
                                    @foreach (var table in Model.Tables.Where(t => t.Status != "Maintenance"))
                                    {
                                        <option value="@table.Id">@table.TableNumber · @table.AreaName · @table.Capacity seats</option>
                                    }
                                </select>
                                <p id="availabilityMessage" class="form-text mb-0" aria-live="polite">Availability is checked again when you submit.</p>
                            </div>
                            <div class="col-12">
                                <label asp-for="NewBooking.SpecialRequests" class="form-label">Special requests (optional)</label>
                                <textarea asp-for="NewBooking.SpecialRequests" maxlength="500" rows="2" class="form-control" placeholder="Allergies, accessibility, other preferences"></textarea>
                            </div>
                            <div class="col-12"><button type="submit" class="btn primary-action w-100" disabled="@(Model.Tables.Count == 0)">Submit Reservation Request</button></div>
                        </div>
                    </form>
                    }
                    <p class="small text-muted mt-3 mb-0">Your booking starts as <strong>Pending</strong>. The restaurant will confirm it. No email or real-time notification is sent in this version.</p>
                </section>
            </div>
            <div class="col-lg-7">
                @if (Model.CustomerBookingsEnabled && Model.Editing is { Status: "Pending" or "Confirmed" } && Model.Editing.StartLocal > ReservationClock.NowLocal)
                {
                    <section class="panel mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 fw-bold mb-0">Edit reservation #@Model.Editing.Id</h2>
                            <a asp-page="/Customer/Reservations" class="btn btn-sm btn-outline-secondary">Close</a>
                        </div>
                        <p class="small text-muted">Changes to a confirmed reservation must be confirmed again by the restaurant.</p>
                        <form method="post" asp-page-handler="Edit" class="row g-3">
                            <input type="hidden" name="id" value="@Model.Editing.Id" />
                            <div class="col-sm-6"><label asp-for="EditBooking.StartLocal" class="form-label">Start (MYT)</label>
                                <input asp-for="EditBooking.StartLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" step="900" class="form-control" /></div>
                            <div class="col-sm-6"><label asp-for="EditBooking.DurationMinutes" class="form-label">Duration</label>
                                <select asp-for="EditBooking.DurationMinutes" class="form-select">
                                    @foreach (var minutes in new[] { 30, 60, 90, 120, 150, 180, 210, 240 })
                                    {
                                        <option value="@minutes">@minutes minutes</option>
                                    }
                                </select></div>
                            <div class="col-sm-6"><label asp-for="EditBooking.PartySize" class="form-label">Guests</label>
                                <input asp-for="EditBooking.PartySize" type="number" min="1" max="20" class="form-control" /></div>
                            <div class="col-sm-6"><label asp-for="EditBooking.TableId" class="form-label">Table</label>
                                <select asp-for="EditBooking.TableId" class="form-select">
                                    @foreach (var table in Model.Tables.Where(t => t.Status != "Maintenance"))
                                    {
                                        <option value="@table.Id">@table.TableNumber (@table.Capacity seats)</option>
                                    }
                                </select></div>
                            <div class="col-12"><label asp-for="EditBooking.SpecialRequests" class="form-label">Special requests</label>
                                <textarea asp-for="EditBooking.SpecialRequests" rows="2" class="form-control" maxlength="500"></textarea></div>
                            <div class="col-12"><button class="btn primary-action" type="submit">Save Changes</button></div>
                        </form>
                    </section>
                }
                <section class="panel">
                    <h2 class="h4 fw-bold mb-3">My Booking History</h2>
                    @if (Model.Bookings.Count == 0)
                    {
                        <p class="text-muted">You haven't booked any tables yet.</p>
                    }
                    @foreach (var item in Model.Bookings)
                    {
                        <article class="border rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <strong>@item.StartLocal.ToString("ddd, dd MMM yyyy · HH:mm")</strong>
                                <span class="pill pill-@item.Status">@item.Status</span>
                            </div>
                            <div class="text-muted small mb-2">Reservation #@item.Id · Table @item.TableNumber · @item.PartySize guest(s) · Until @item.EndLocal.ToString("HH:mm")</div>
                            @if (!string.IsNullOrWhiteSpace(item.SpecialRequests))
                            {
                                <p class="small mb-2">Requests: @item.SpecialRequests</p>
                            }
                            @if (item.StartLocal > ReservationClock.NowLocal && (item.Status is "Pending" or "Confirmed"))
                            {
                                <div class="d-flex gap-2">
                                    @if (Model.CustomerBookingsEnabled)
                                    {
                                        <a asp-page="/Customer/Reservations" asp-route-editId="@item.Id" class="btn btn-outline-dark btn-sm">Modify</a>
                                    }
                                    <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Cancel this reservation?')">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                    </form>
                                </div>
                            }
                        </article>
                    }
                </section>
            </div>
        </div>
    </main>
    <script>
        document.getElementById('checkAvailability')?.addEventListener('click', async () => {
            const date = document.getElementById('NewBooking_StartLocal').value;
            const duration = document.getElementById('NewBooking_DurationMinutes').value;
            const partySize = document.getElementById('NewBooking_PartySize').value;
            const select = document.getElementById('availableTables');
            const message = document.getElementById('availabilityMessage');
            if (!date || !partySize) { message.textContent = 'Choose a date, time and party size first.'; return; }
            message.textContent = 'Checking…';
            try {
                const params = new URLSearchParams({ handler: 'Availability', startLocal: date, durationMinutes: duration, partySize });
                const response = await fetch('/Customer/Reservations?' + params, { credentials: 'same-origin' });
                if (!response.ok) throw new Error('Availability request failed');
                const tables = await response.json();
                select.replaceChildren(new Option('Choose a table', ''));
                tables.forEach(t => select.add(new Option(t.label, t.id)));
                message.textContent = tables.length ? `${tables.length} table(s) available.` : 'No tables available for that time and party size.';
            } catch { message.textContent = 'Availability could not be checked. Please try again.'; }
        });
    </script>
</body>
</html>
