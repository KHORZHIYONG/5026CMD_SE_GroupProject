@page "/Announcements"
@model ResROMS.Pages.AnnouncementsModel
@{
    ViewData["Title"] = "Announcements";
    Layout = User.IsInRole("Admin") ? "_AdminLayout"
        : (User.IsInRole("Waiter") || User.IsInRole("Kitchen Staff") || User.IsInRole("Staff"))
            ? "/Pages/Staff/_StaffLayout.cshtml" : "_CustomerLayout";
}
<div class="py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
        <div><h1 class="fw-bold">Restaurant Announcements</h1><p class="text-muted">Current notices from ResROMS.</p></div>
        <a href="@(User.IsInRole("Admin") ? "/Admin/Announcements" : (User.IsInRole("Customer") ? "/Customer/Dashboard" : "/Staff/Orders"))" class="btn btn-outline-secondary">Back</a>
    </div>
    @if (Model.Posts.Count == 0)
    {
        <div class="alert alert-light border">There are no active announcements for your account.</div>
    }
    @foreach (var post in Model.Posts)
    {
        <article class="card shadow-sm border-0 rounded-4 mb-3">
            <div class="card-body p-4">
                <h2 class="h5 fw-bold">@post.Title</h2>
                <p class="text-muted small">From @post.StartLocal.ToString("dd MMM yyyy HH:mm") MYT
                    @if (post.EndLocal.HasValue) { <span> until @post.EndLocal.Value.ToString("dd MMM yyyy HH:mm") MYT</span> }
                </p>
                <p style="white-space:pre-line;overflow-wrap:anywhere;" class="mb-0">@post.Body</p>
            </div>
        </article>
    }
</div>
