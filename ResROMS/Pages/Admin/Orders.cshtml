@page "/Admin/Orders"
@model ResROMS.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Orders Monitoring";
    var stages = new[] { "New", "Cooking", "Ready", "Completed" };
}
@section Styles {
<style>
    .order-board { display:flex; gap:16px; overflow-x:auto; padding-bottom:18px; align-items:flex-start; }
    .order-lane { flex:1 0 245px; min-width:245px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; }
    .lane-head { padding:14px 16px; border-bottom:2px solid #e2e8f0; display:flex; align-items:center; justify-content:space-between; font-weight:700; }
    .lane-New .lane-head { background:#fffaf0; color:#b45309; }
    .lane-Cooking .lane-head { background:#eff6ff; color:#1d4ed8; }
    .lane-Ready .lane-head { background:#f0fdf4; color:#15803d; }
    .lane-Completed .lane-head { background:#f1f5f9; color:#475569; }
    .order-list { padding:12px; display:flex; flex-direction:column; gap:12px; max-height:65vh; overflow-y:auto; }
    .order-card { background:#fff; border-radius:9px; padding:13px; box-shadow:0 2px 7px rgba(0,0,0,.04); border-left:4px solid #cbd5e1; }
    .lane-New .order-card { border-left-color:#dd6b20; }
    .lane-Cooking .order-card { border-left-color:#3182ce; }
    .lane-Ready .order-card { border-left-color:#38a169; }
    .order-lines { margin:10px 0; padding-left:19px; color:#475569; font-size:.9rem; }
    .order-lines li { padding:2px 0; }
    .manual-order { background:white; border:1px solid #e2e8f0; border-radius:12px; margin-bottom:20px; }
    .manual-order summary { cursor:pointer; font-weight:600; padding:15px 18px; }
    .manual-order-inner { padding:0 18px 18px; }
</style>
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div><h1 class="h3 fw-bold mb-1">Order Monitoring</h1>
        <p class="text-muted mb-0">Database-backed kitchen status board. Refresh to view the latest changes.</p></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-dark" href="/Admin/Payments"><i class="bi bi-credit-card me-1"></i>Payments</a>
        <a class="btn btn-dark" href="/Admin/Orders"><i class="bi bi-arrow-clockwise me-1"></i>Refresh Board</a></div>
</div>
@if (TempData["SuccessMessage"] is string good) { <div class="alert alert-success">@good</div> }
@if (TempData["ErrorMessage"] is string problem) { <div class="alert alert-danger">@problem</div> }
<details class="manual-order">
    <summary><i class="bi bi-plus-circle me-2"></i>Record a manual order (Administrator)</summary>
    <div class="manual-order-inner">
        <p class="small text-muted">This saves a real order with current menu prices. Leave Customer blank for a walk-in and Table blank for takeaway. Up to 3 different dishes can be entered here; the shared service supports more.</p>
        <form method="post" asp-page-handler="Create">
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label class="form-label">Customer (optional)</label><select class="form-select" asp-for="NewOrder.CustomerId"><option value="">Walk-in</option>
                @foreach (var c in Model.CustomerChoices) { <option value="@c.Id">@c.Name</option> }
                </select></div>
                <div class="col-md-6"><label class="form-label">Table (optional)</label><select class="form-select" asp-for="NewOrder.TableId"><option value="">Takeaway / no table</option>
                @foreach (var t in Model.TableChoices) { <option value="@t.Id">@t.Label</option> }
                </select></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-9"><label class="form-label">Dish 1</label><select class="form-select" asp-for="NewOrder.Item1" required><option value="">Select a dish</option>
                @foreach (var group in Model.MenuChoices.GroupBy(x => x.CategoryName))
                { <optgroup label="@group.Key">
                  @foreach (var item in group) { <option value="@item.Id">@item.Name (RM @item.Price.ToString("F2"))</option> }
                  </optgroup> }
                </select></div><div class="col-md-3"><label class="form-label">Qty</label><input class="form-control" asp-for="NewOrder.Qty1" type="number" min="1" max="99" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-9"><label class="form-label">Dish 2 (optional)</label><select class="form-select" asp-for="NewOrder.Item2"><option value="">None</option>
                @foreach (var group in Model.MenuChoices.GroupBy(x => x.CategoryName))
                { <optgroup label="@group.Key">
                  @foreach (var item in group) { <option value="@item.Id">@item.Name (RM @item.Price.ToString("F2"))</option> }
                  </optgroup> }
                </select></div><div class="col-md-3"><label class="form-label">Qty</label><input class="form-control" asp-for="NewOrder.Qty2" type="number" min="1" max="99" /></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-9"><label class="form-label">Dish 3 (optional)</label><select class="form-select" asp-for="NewOrder.Item3"><option value="">None</option>
                @foreach (var group in Model.MenuChoices.GroupBy(x => x.CategoryName))
                { <optgroup label="@group.Key">
                  @foreach (var item in group) { <option value="@item.Id">@item.Name (RM @item.Price.ToString("F2"))</option> }
                  </optgroup> }
                </select></div><div class="col-md-3"><label class="form-label">Qty</label><input class="form-control" asp-for="NewOrder.Qty3" type="number" min="1" max="99" /></div>
            </div>
            <div class="mb-3"><label class="form-label" asp-for="NewOrder.PromoCode">Promotion code (optional)</label>
                <input class="form-control" asp-for="NewOrder.PromoCode" maxlength="24" placeholder="e.g. LUNCH10" /></div>
            <button class="btn btn-dark" type="submit">Save Order to Database</button>
        </form>
    </div>
</details>
<div class="order-board">
    @foreach (var stage in stages)
    {
        var rows = Model.Orders.Where(o => o.Status == stage).OrderBy(o => o.OrderedLocal).ToList();
        <section class="order-lane lane-@stage">
            <div class="lane-head"><span>@stage</span><span class="badge rounded-pill text-bg-light">@rows.Count</span></div>
            <div class="order-list">
                @if (rows.Count == 0) { <p class="text-muted text-center small my-3">No @stage.ToLowerInvariant() orders.</p> }
                @foreach (var order in rows)
                {
                    <article class="order-card">
                        <div class="d-flex justify-content-between fw-bold mb-2"><span>@order.TableLabel</span><span>#@order.Id</span></div>
                        <div class="small text-muted">Customer: @order.CustomerName</div>
                        <div class="small text-muted">Entered by: @order.EnteredBy</div>
                        <div class="small text-muted">@order.OrderedLocal.ToString("dd MMM yyyy, hh:mm tt")</div>
                        <ul class="order-lines">
                            @foreach (var line in order.Lines) { <li>@line.Quantity × @line.Name — RM @line.Total.ToString("F2")</li> }
                        </ul>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mb-2"><div><strong>RM @order.TotalAmount.ToString("F2")</strong>
                            @if (order.DiscountAmount > 0) { <div class="small text-success">Discount @(string.IsNullOrEmpty(order.AppliedPromoCode) ? "" : $"({order.AppliedPromoCode})") -RM @order.DiscountAmount.ToString("F2")</div> }</div>
                            <span class="badge @(order.PaymentStatus == "Paid" ? "text-bg-success" : order.PaymentStatus == "Refunded" ? "text-bg-warning" : "text-bg-secondary")">@order.PaymentStatus</span></div>
                        @if (stage != "Completed")
                        {
                            var next = stage == "New" ? "Cooking" : stage == "Cooking" ? "Ready" : "Completed";
                            <form method="post" asp-page-handler="UpdateStatus" class="mb-2">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="newStatus" value="@next" />
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Move to @next</button>
                            </form>
                            @if (stage is "New" or "Cooking")
                            {
                                <form method="post" asp-page-handler="UpdateStatus" onsubmit="return confirm('Cancel this order?');">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <input type="hidden" name="newStatus" value="Cancelled" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">Cancel Order</button>
                                </form>
                            }
                        }
                    </article>
                }
            </div>
        </section>
    }
</div>
@if (Model.Orders.Any(o => o.Status == "Cancelled"))
{
    <details class="bg-white border rounded p-3"><summary class="fw-semibold">Cancelled orders (@Model.Orders.Count(o => o.Status == "Cancelled"))</summary>
        <div class="mt-3 table-responsive"><table class="table table-sm"><thead><tr><th>Order</th><th>Customer</th><th>Table</th><th>Total</th><th>Payment</th></tr></thead><tbody>
        @foreach (var order in Model.Orders.Where(o => o.Status == "Cancelled"))
        { <tr><td>#@order.Id</td><td>@order.CustomerName</td><td>@order.TableLabel</td><td>RM @order.TotalAmount.ToString("F2")</td><td>@order.PaymentStatus</td></tr> }
        </tbody></table></div>
    </details>
}
<p class="small text-muted mt-3">Showing up to 200 most recent orders. Order transitions and payment records are stored in SQL Server. This is a refresh-based board, not a real-time push notification feed.</p>
