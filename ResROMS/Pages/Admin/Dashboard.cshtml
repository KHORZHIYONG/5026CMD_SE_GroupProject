@page "/Admin/Dashboard"
@model ResROMS.Pages.Admin.DashboardModel
@using System.Text.Json
@{
    ViewData["Title"] = "Admin Dashboard";
    var labels = JsonSerializer.Serialize(Model.Data.LastSevenDays.Select(x => x.Label));
    var revenue = JsonSerializer.Serialize(Model.Data.LastSevenDays.Select(x => x.NetCollected));
    var statusNames = JsonSerializer.Serialize(Model.Data.TableStatuses.Select(x => x.Status));
    var statusCounts = JsonSerializer.Serialize(Model.Data.TableStatuses.Select(x => x.Count));
}

@section Styles {
<style>
    .report-heading { display:flex; gap:1rem; justify-content:space-between; align-items:center; flex-wrap:wrap; }
    .report-eyebrow { font-size:.8rem; font-weight:700; letter-spacing:.05em; color:#718096; text-transform:uppercase; }
    .report-card { border:0; border-radius:14px; box-shadow:0 4px 15px rgba(0,0,0,.045); height:100%; }
    .report-kpi { font-size:2rem; font-weight:700; letter-spacing:-.03em; color:#22252d; }
    .report-caption { color:#718096; font-size:.86rem; }
    .report-chart { position:relative; min-height:270px; height:300px; }
    .quick-links { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; }
    .quick-link { display:flex; align-items:center; gap:10px; padding:15px; background:#fff; border-radius:12px; text-decoration:none; font-weight:600; color:#e85d04; box-shadow:0 3px 14px rgba(0,0,0,.04); }
    .quick-link:hover { color:#c84f00; background:#fff8f3; }
    .nowrap { white-space:nowrap; }
</style>
}

<div class="report-heading mb-4">
    <div>
        <h1 class="fw-bold mb-1">Administrator Overview</h1>
        <p class="text-muted mb-0">Live reporting from SQL Server · Restaurant time (Malaysia, UTC+8)</p>
    </div>
    <a asp-page="/Admin/Reports" class="btn btn-outline-dark"><i class="bi bi-bar-chart me-1"></i> Detailed Reports</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card report-card p-4">
            <div class="report-eyebrow">Today's reservations</div>
            <div class="report-kpi">@Model.Data.TodayReservations</div>
            <div class="report-caption">Today's non-cancelled bookings</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card report-card p-4">
            <div class="report-eyebrow">Active orders</div>
            <div class="report-kpi">@Model.Data.ActiveOrders</div>
            <div class="report-caption">New, Cooking and Ready</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card report-card p-4">
            <div class="report-eyebrow">Today's net collected</div>
            <div class="report-kpi text-success">RM @Model.Data.TodayNetCollected.ToString("N2")</div>
            <div class="report-caption">Recorded payments less recorded refunds today</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card report-card p-4">
            <h5 class="fw-bold mb-1">Net Collected — Last 7 Days</h5>
            <p class="report-caption">RM · Payments on date recorded minus refunds on date marked</p>
            <div class="report-chart"><canvas id="revenueChart" aria-label="Daily net collected revenue chart" role="img"></canvas></div>
            <div class="report-caption mt-2" id="chartFallback" hidden>Chart couldn't load. View the figures in Detailed Reports.</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card report-card p-4">
            <h5 class="fw-bold mb-1">Current Table Statuses</h5>
            <p class="report-caption">Operational table statuses, not future availability</p>
            <div class="report-chart"><canvas id="tableChart" aria-label="Current table statuses chart" role="img"></canvas></div>
            @if (Model.Data.TableStatuses.Count == 0)
            {
                <p class="report-caption text-center">No tables created yet.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                    @foreach (var status in Model.Data.TableStatuses)
                    {
                        <span class="badge bg-light text-dark border">@status.Status: @status.Count</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card report-card p-4">
            <h5 class="fw-bold mb-3">Upcoming Reservations</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Starts</th><th>Guest</th><th>Table</th><th>Guests</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var booking in Model.Data.UpcomingBookings)
                    {
                        <tr>
                            <td class="nowrap">@booking.StartLocal.ToString("dd MMM, h:mm tt")</td>
                            <td>@booking.CustomerName</td>
                            <td>@booking.TableNumber</td>
                            <td>@booking.PartySize</td>
                            <td><span class="badge bg-light text-dark border">@booking.Status</span></td>
                        </tr>
                    }
                    @if (Model.Data.UpcomingBookings.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted py-4 text-center">No bookings in the next seven days.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <a asp-page="/Admin/Reservations" class="mt-3 text-decoration-none fw-semibold" style="color:#e85d04">Manage reservations <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card report-card p-4">
            <h5 class="fw-bold mb-1">Most Ordered Dishes</h5>
            <p class="report-caption">By quantity · Last 7 days · Excludes cancelled orders</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Dish</th><th class="text-end">Units</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Data.PopularItems)
                    {
                        <tr><td>@item.Name</td><td class="fw-semibold text-end">@item.Quantity</td></tr>
                    }
                    @if (Model.Data.PopularItems.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted py-4 text-center">No orders in this period.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold mb-3">Management Shortcuts</h5>
<div class="quick-links">
    <a asp-page="/Admin/RestaurantInfo" class="quick-link"><i class="bi bi-shop"></i> Restaurant Setup</a>
    <a asp-page="/Admin/Accounts" class="quick-link"><i class="bi bi-people"></i> Accounts</a>
    <a asp-page="/Admin/Menu" class="quick-link"><i class="bi bi-journal-richtext"></i> Menu & Pricing</a>
    <a asp-page="/Admin/Orders" class="quick-link"><i class="bi bi-list-check"></i> Orders</a>
    <a asp-page="/Admin/Payments" class="quick-link"><i class="bi bi-credit-card"></i> Payments</a>
    <a asp-page="/Admin/Campaigns" class="quick-link"><i class="bi bi-megaphone"></i> Campaigns</a>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    (() => {
        if (typeof Chart === 'undefined') {
            document.getElementById('chartFallback').hidden = false;
            return;
        }
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(labels),
                datasets: [{
                    label: 'Net collected (RM)',
                    data: @Html.Raw(revenue),
                    borderColor: '#e85d04',
                    backgroundColor: 'rgba(232,93,4,.10)',
                    pointRadius: 4, tension: .3, fill: true
                }]
            },
            options: { responsive:true, maintainAspectRatio:false,
                scales: {y:{ticks:{callback:value => 'RM ' + value}}} }
        });
        new Chart(document.getElementById('tableChart'), {
            type:'doughnut',
            data: {
                labels: @Html.Raw(statusNames),
                datasets:[{
                    data: @Html.Raw(statusCounts),
                    backgroundColor:['#e85d04','#fca311','#3aa7a3','#8f77d6','#cbd5e1'],
                    borderWidth:0
                }]
            },
            options:{responsive:true, maintainAspectRatio:false, cutout:'65%'}
        });
    })();
</script>
}
