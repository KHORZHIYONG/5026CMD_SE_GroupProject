@page "/Admin/Reports"
@model ResROMS.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Reports & Analytics";
}
@section Styles {
<style>
    .analytics-card { border:0; border-radius:14px; box-shadow:0 4px 15px rgba(0,0,0,.045); }
    .analytics-label { font-size:.77rem; letter-spacing:.05em; text-transform:uppercase; font-weight:700; color:#718096; }
    .analytics-value { font-size:1.55rem; font-weight:700; color:#272c33; }
    .analytics-hint { font-size:.82rem; color:#718096; }
    .data-table th { color:#607080; font-size:.86rem; }
</style>
}
<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-4">
    <div>
        <h1 class="fw-bold mb-1">Reports & Analytics</h1>
        <p class="text-muted mb-0">Database-backed reports · Malaysia-local calendar dates (UTC+8)</p>
    </div>
    <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
</div>
<div class="card analytics-card p-4 mb-4">
    <form method="get" asp-page="/Admin/Reports" class="row g-3 align-items-end">
        <div class="col-md-3"><label for="from" class="form-label fw-semibold">From</label><input id="from" type="date" class="form-control" name="from" value="@Model.FromText" required /></div>
        <div class="col-md-3"><label for="to" class="form-label fw-semibold">To (inclusive)</label><input id="to" type="date" class="form-control" name="to" value="@Model.ToText" required /></div>
        <div class="col-md-3"><label for="grouping" class="form-label fw-semibold">Group by</label>
            <select id="grouping" class="form-select" name="grouping">
                <option value="Daily" selected="@(Model.Grouping == "Daily")">Daily</option>
                <option value="Weekly" selected="@(Model.Grouping == "Weekly")">Weekly (Monday start)</option>
                <option value="Monthly" selected="@(Model.Grouping == "Monthly")">Monthly</option>
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-dark w-100" type="submit"><i class="bi bi-funnel me-1"></i> Apply Filters</button></div>
    </form>
    <div class="analytics-hint mt-2">Date range is limited to 366 days; dates refer to booking start, order placement, payment collection or refund date as relevant.</div>
</div>
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Data is { } report)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Reservations</div><div class="analytics-value">@report.Reservations</div><div class="analytics-hint">Excludes cancelled</div></div></div>
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Orders</div><div class="analytics-value">@report.Orders</div><div class="analytics-hint">Excludes cancelled</div></div></div>
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Order value</div><div class="analytics-value">RM @report.OrderValue.ToString("N2")</div><div class="analytics-hint">Unpaid included; not revenue</div></div></div>
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Collected</div><div class="analytics-value">RM @report.CollectedPayments.ToString("N2")</div><div class="analytics-hint">Manual payment records</div></div></div>
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Refunds</div><div class="analytics-value">RM @report.RecordedRefunds.ToString("N2")</div><div class="analytics-hint">Marked refunded</div></div></div>
        <div class="col-md-4 col-xl-2"><div class="card analytics-card p-3 h-100"><div class="analytics-label">Net collected</div><div class="analytics-value text-success">RM @report.NetCollected.ToString("N2")</div><div class="analytics-hint">Collected minus refunds</div></div></div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="card analytics-card p-3"><strong>New customer accounts</strong><span class="fs-4 fw-bold">@report.NewCustomers</span><small class="text-muted">Registered during selected dates</small></div></div>
        <div class="col-md-6"><div class="card analytics-card p-3"><strong>Customers with activity</strong><span class="fs-4 fw-bold">@report.ActiveCustomers</span><small class="text-muted">Distinct customers with an order or reservation in the period</small></div></div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card analytics-card p-4 h-100">
                <div class="d-flex justify-content-between flex-wrap gap-2 align-items-center mb-3">
                    <div><h5 class="fw-bold mb-1">Sales & Operations Trend</h5><div class="analytics-hint">Each row covers a local calendar period</div></div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Export" asp-route-dataset="sales" asp-route-from="@Model.FromText" asp-route-to="@Model.ToText" asp-route-grouping="@Model.Grouping"><i class="bi bi-download me-1"></i> Sales CSV</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Export" asp-route-dataset="reservations" asp-route-from="@Model.FromText" asp-route-to="@Model.ToText" asp-route-grouping="@Model.Grouping">Reservations CSV</a>
                    </div>
                </div>
                <div class="table-responsive" style="max-height:430px;overflow-y:auto">
                    <table class="table data-table table-striped table-hover align-middle">
                        <thead class="sticky-top bg-white"><tr><th>Period</th><th class="text-end">Net collected (RM)</th><th class="text-end">Reservations</th><th class="text-end">Orders</th></tr></thead>
                        <tbody>
                        @foreach (var t in report.Trend)
                        {
                            <tr><td>@t.Label</td><td class="text-end">@t.NetCollected.ToString("N2")</td><td class="text-end">@t.Reservations</td><td class="text-end">@t.Orders</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card analytics-card p-4 h-100">
                <h5 class="fw-bold">Reservation Status Breakdown</h5>
                <div class="analytics-hint mb-3">Includes cancelled bookings for visibility</div>
                <table class="table table-striped"><thead><tr><th>Status</th><th class="text-end">Count</th></tr></thead><tbody>
                @foreach (var s in report.ReservationStatuses)
                {
                    <tr><td>@s.Status</td><td class="text-end">@s.Count</td></tr>
                }
                @if (report.ReservationStatuses.Count == 0)
                {
                    <tr><td colspan="2" class="text-muted">No reservation records for this period.</td></tr>
                }
                </tbody></table>
                <p class="analytics-hint mt-auto">Pending: @report.PendingReservations · Cancelled: @report.CancelledReservations</p>
            </div>
        </div>
    </div>
    <div class="card analytics-card p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div><h5 class="fw-bold mb-1">Popular Menu Items</h5><p class="analytics-hint mb-0">Top 10 by quantity in non-cancelled orders; includes unpaid orders</p></div>
            <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Export" asp-route-dataset="popular" asp-route-from="@Model.FromText" asp-route-to="@Model.ToText" asp-route-grouping="@Model.Grouping"><i class="bi bi-download me-1"></i> Export CSV</a>
        </div>
        <div class="table-responsive"><table class="table data-table align-middle mb-0">
            <thead><tr><th>Item</th><th class="text-end">Quantity</th><th class="text-end">Order value (RM)</th></tr></thead>
            <tbody>
            @foreach (var item in report.PopularItems)
            {
                <tr><td>@item.Name</td><td class="text-end">@item.Quantity</td><td class="text-end">@item.OrderValue.ToString("N2")</td></tr>
            }
            @if (report.PopularItems.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-muted py-4">No menu-item orders for this period.</td></tr>
            }
            </tbody>
        </table></div>
    </div>
    <p class="text-muted small">Financial figures reflect manually recorded payments and refunds in the database, not a payment gateway or audited bank settlement.</p>
}
