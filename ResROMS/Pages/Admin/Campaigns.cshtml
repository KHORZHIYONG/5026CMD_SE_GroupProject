@page "/Admin/Campaigns"
@model ResROMS.Pages.Admin.CampaignsModel
@{
    ViewData["Title"] = "Marketing & Campaigns";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        /* Campaign Cards */
        .campaign-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid #edf2f7;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .campaign-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            }

        /* Status Badges */
        .badge-active {
            background: rgba(56, 161, 105, 0.15);
            color: #276749;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
        }

        .badge-scheduled {
            background: rgba(214, 158, 46, 0.15);
            color: #975a16;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
        }

        .badge-ended {
            background: rgba(160, 174, 192, 0.15);
            color: #4a5568;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
        }

        /* Type Icons */
        .type-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-right: 15px;
        }

        .icon-discount {
            background: #ebf8ff;
            color: #3182ce;
        }

        .icon-happyhour {
            background: #fffaf0;
            color: #dd6b20;
        }

        .icon-seasonal {
            background: #faf5ff;
            color: #805ad5;
        }

        .promo-code-box {
            background: #f7fafc;
            border: 1px dashed #cbd5e0;
            padding: 8px;
            border-radius: 6px;
            text-align: center;
            font-family: monospace;
            font-weight: 700;
            color: #2d3748;
            letter-spacing: 1px;
        }

        .btn-primary-custom {
            background-color: #e85d04;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #dc2f02;
                color: white;
            }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Marketing Campaigns</h1>
        <p class="text-muted small mb-0">Manage discounts, seasonal offers, and happy hours to drive sales.</p>
    </div>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addCampaignModal">
        <i class="bi bi-megaphone-fill me-1"></i> New Campaign
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Campaign Grid -->
<div class="row g-4">
    @foreach (var campaign in Model.Campaigns)
    {
        var statusBadge = campaign.Status switch
        {
            "Active" => "badge-active",
            "Scheduled" => "badge-scheduled",
            _ => "badge-ended"
        };

        var iconClass = campaign.Type switch
        {
            "Discount" => "icon-discount bi-tags-fill",
            "Happy Hour" => "icon-happyhour bi-clock-fill",
            _ => "icon-seasonal bi-calendar-star-fill"
        };

        <div class="col-12 col-md-6 col-lg-4">
            <div class="campaign-card @(campaign.Status == "Ended" ? "opacity-75" : "")">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="d-flex align-items-center">
                        <div class="type-icon"><i class="bi @iconClass"></i></div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0">@campaign.Name</h5>
                            <span class="small text-muted">@campaign.Type</span>
                        </div>
                    </div>
                    <span class="@statusBadge">@campaign.Status</span>
                </div>

                <p class="text-muted small flex-grow-1">@campaign.Description</p>

                <div class="mb-3">
                    <div class="small fw-bold text-dark mb-1">Promo Code:</div>
                    <div class="promo-code-box">@campaign.PromoCode</div>
                </div>

                <hr class="border-light my-3">

                <div class="d-flex justify-content-between align-items-center small">
                    <div>
                        <div class="text-muted"><i class="bi bi-calendar3 me-1"></i> Valid</div>
                        <div class="fw-bold text-dark">@campaign.StartDate.ToString("MMM dd") - @campaign.EndDate.ToString("MMM dd, yyyy")</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted"><i class="bi bi-people-fill me-1"></i> Uses</div>
                        <div class="fw-bold text-dark fs-6">@campaign.UsageCount</div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add New Campaign -->
<div class="modal fade" id="addCampaignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create New Campaign</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddCampaign" method="post">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Campaign Name</label>
                            <input asp-for="NewCampaign.Name" class="form-control" placeholder="e.g. Back to School Special" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Campaign Type</label>
                            <select asp-for="NewCampaign.Type" class="form-select" required>
                                <option value="Discount">Discount Code</option>
                                <option value="Happy Hour">Happy Hour</option>
                                <option value="Seasonal">Seasonal Menu</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Promo Code (Leave blank if auto-applied)</label>
                            <input asp-for="NewCampaign.PromoCode" class="form-control" placeholder="e.g. SCHOOL20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Start Date</label>
                            <input asp-for="NewCampaign.StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">End Date</label>
                            <input asp-for="NewCampaign.EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Description / Rules</label>
                            <textarea asp-for="NewCampaign.Description" class="form-control" rows="3" placeholder="Describe the offer details..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Schedule Campaign</button>
                </div>
            </form>
        </div>
    </div>
</div>