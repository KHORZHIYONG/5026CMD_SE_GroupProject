@page "/Admin/Campaigns"
@model ResROMS.Pages.Admin.CampaignsModel
@{
    ViewData["Title"] = "Marketing & Campaigns";
}

@section Styles {
<style>
    .page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:14px;flex-wrap:wrap}
    .page-title{font-size:1.8rem;font-weight:700;color:#2d3748;margin:0}
    .campaign-card{background:#fff;border-radius:12px;padding:20px;box-shadow:0 4px 15px rgba(0,0,0,.03);border:1px solid #edf2f7;height:100%;display:flex;flex-direction:column}
    .campaign-card:hover{box-shadow:0 8px 20px rgba(0,0,0,.06)}
    .badge-active,.badge-scheduled,.badge-ended,.badge-paused{font-weight:700;padding:5px 12px;border-radius:20px;font-size:.75rem}
    .badge-active{background:rgba(56,161,105,.15);color:#276749}
    .badge-scheduled{background:rgba(214,158,46,.15);color:#975a16}
    .badge-ended{background:rgba(160,174,192,.15);color:#4a5568}
    .badge-paused{background:#fee2e2;color:#991b1b}
    .type-icon{width:45px;height:45px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-right:15px;flex-shrink:0}
    .icon-discount{background:#ebf8ff;color:#3182ce}
    .icon-happyhour{background:#fffaf0;color:#dd6b20}
    .icon-seasonal{background:#faf5ff;color:#805ad5}
    .promo-code-box{background:#f7fafc;border:1px dashed #cbd5e0;padding:8px;border-radius:6px;text-align:center;font-family:monospace;font-weight:700;color:#2d3748;letter-spacing:.5px}
    .btn-primary-custom{background-color:#e85d04;border:none;font-weight:600;border-radius:8px;color:#fff}
    .btn-primary-custom:hover{background-color:#dc2f02;color:#fff}
    .campaign-actions{display:flex;gap:8px;flex-wrap:wrap}
    .campaign-actions form{display:inline}
    .edit-panel{background:#f8fafc;border-radius:9px;border:1px solid #e2e8f0;padding:16px;margin-top:15px}
    .promo-field-error { display:none; color:#ad2727; font-size:.8rem; margin-top:4px; font-weight:600; }
    .promo-field-error.visible { display:block; }
</style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Marketing Campaigns</h1>
        <p class="text-muted small mb-0">Manage promotional offers and codes saved in SQL Server.</p>
    </div>
    <button class="btn btn-primary-custom" type="button" data-bs-toggle="modal" data-bs-target="#addCampaignModal">
        <i class="bi bi-megaphone-fill me-1"></i> New Campaign
    </button>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="alert alert-info small" role="note">
    Campaign dates, codes and discounts are stored in the database. Applying discounts at checkout and recording redemptions
    will be connected when the Orders and Payments modules are implemented. Current redemption counts start at zero.
</div>

@if (Model.Campaigns.Count == 0)
{
    <div class="alert alert-light border">No campaigns have been created yet. Use <strong>New Campaign</strong> to add your first promotion.</div>
}
else
{
    <div class="row g-4">
        @foreach (var campaign in Model.Campaigns)
        {
            var editing = Model.EditCampaignId == campaign.Id;
            var edited = editing ? Model.Form : null;
            var statusBadge = campaign.Status switch
            {
                "Active" => "badge-active",
                "Scheduled" => "badge-scheduled",
                "Paused" => "badge-paused",
                _ => "badge-ended"
            };
            var iconClass = campaign.Type switch
            {
                "Discount" => "icon-discount bi-tags-fill",
                "Happy Hour" => "icon-happyhour bi-clock-fill",
                _ => "icon-seasonal bi-calendar-star-fill"
            };
            <div class="col-12 col-lg-6 col-xxl-4">
                <div class="campaign-card @(campaign.Status is "Ended" or "Paused" ? "opacity-75" : "")">
                    <div class="d-flex justify-content-between align-items-start mb-3 gap-2">
                        <div class="d-flex align-items-center">
                            <div class="type-icon"><i class="bi @iconClass"></i></div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@campaign.Name</h5>
                                <span class="small text-muted">@campaign.Type</span>
                            </div>
                        </div>
                        <span class="@statusBadge">@campaign.Status</span>
                    </div>
                    <p class="text-muted small flex-grow-1">@campaign.Description</p>
                    <div class="mb-2">
                        <div class="small fw-bold mb-1">Promo Code</div>
                        <div class="promo-code-box" data-campaign-id="@campaign.Id" data-promo-code="@campaign.PromoCode">@(campaign.PromoCode ?? "No code (manual/auto offer)")</div>
                    </div>
                    <div class="small mb-2 text-muted">
                        Discount: <strong class="text-dark">
                            @(campaign.DiscountType == "Percentage" ? $"{campaign.DiscountValue:0.##}%" :
                                campaign.DiscountType == "FixedAmount" ? $"RM {campaign.DiscountValue:0.00}" : "No monetary discount")
                        </strong>
                    </div>
                    <hr class="border-light my-2" />
                    <div class="d-flex justify-content-between small mb-3">
                        <div>
                            <div class="text-muted"><i class="bi bi-calendar3 me-1"></i>Dates (Malaysia)</div>
                            <div class="fw-bold text-dark">@campaign.StartDate.ToString("dd MMM yyyy") – @campaign.EndDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted"><i class="bi bi-people-fill me-1"></i>Recorded uses</div>
                            <div class="fw-bold text-dark">@campaign.UsageCount</div>
                        </div>
                    </div>
                    <div class="campaign-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#editCampaign-@campaign.Id" aria-controls="editCampaign-@campaign.Id" aria-expanded="false">Edit</button>
                        @if (campaign.IsEnabled)
                        {
                            <form method="post" asp-page-handler="Pause">
                                <input type="hidden" name="CampaignId" value="@campaign.Id" />
                                <button type="submit" class="btn btn-outline-warning btn-sm">Pause</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Resume">
                                <input type="hidden" name="CampaignId" value="@campaign.Id" />
                                <button type="submit" class="btn btn-outline-success btn-sm">Resume</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Permanently delete this unused campaign?');">
                            <input type="hidden" name="CampaignId" value="@campaign.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm" disabled="@(campaign.UsageCount > 0)">Delete</button>
                        </form>
                    </div>
                    <div class="collapse @(editing ? "show" : "")" id="editCampaign-@campaign.Id">
                        <div class="edit-panel">
                            <h6 class="fw-bold">Edit campaign</h6>
                            <form method="post" asp-page-handler="Edit">
                                @if (editing)
                                {
                                    <div asp-validation-summary="All" class="alert alert-danger small" role="alert"></div>
                                }
                                <input type="hidden" name="CampaignId" value="@campaign.Id" />
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Name</label>
                                    <input class="form-control form-control-sm" name="Form.Name" value="@(edited?.Name ?? campaign.Name)" maxlength="120" required />
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Type</label>
                                        <select class="form-select form-select-sm" name="Form.Type">
                                            @foreach (var type in new[] { "Discount", "Happy Hour", "Seasonal" })
                                            {
                                                <option value="@type" selected="@(type == (edited?.Type ?? campaign.Type))">@type</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Promo Code (optional)</label>
                                        <input class="form-control form-control-sm" name="Form.PromoCode" value="@(edited?.PromoCode ?? campaign.PromoCode)" maxlength="24" data-promo-edit="@campaign.Id" />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Discount type</label>
                                        <select class="form-select form-select-sm" name="Form.DiscountType">
                                            @foreach (var type in new[] { "None", "Percentage", "FixedAmount" })
                                            {
                                                <option value="@type" selected="@(type == (edited?.DiscountType ?? campaign.DiscountType))">@(type == "FixedAmount" ? "Fixed amount (RM)" : type)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Discount value</label>
                                        <input type="number" class="form-control form-control-sm" name="Form.DiscountValue" value="@((edited?.DiscountValue ?? campaign.DiscountValue).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" min="0" step="0.01" required />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Start</label>
                                        <input type="date" class="form-control form-control-sm" name="Form.StartDate" value="@((edited?.StartDate ?? campaign.StartDate).ToString("yyyy-MM-dd"))" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">End</label>
                                        <input type="date" class="form-control form-control-sm" name="Form.EndDate" value="@((edited?.EndDate ?? campaign.EndDate).ToString("yyyy-MM-dd"))" required />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Description and rules</label>
                                    <textarea class="form-control form-control-sm" name="Form.Description" rows="3" maxlength="1000" required>@(edited?.Description ?? campaign.Description)</textarea>
                                </div>
                                <button type="submit" class="btn btn-primary-custom btn-sm">Save changes</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="modal fade" id="addCampaignModal" tabindex="-1" aria-labelledby="campaignModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="campaignModalTitle">Create New Campaign</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small px-3 pt-2"></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Form.Name" class="form-label fw-bold">Campaign Name</label>
                            <input asp-for="Form.Name" class="form-control" maxlength="120" placeholder="e.g. Weekend Special" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Form.Type" class="form-label fw-bold">Campaign Type</label>
                            <select asp-for="Form.Type" class="form-select" required>
                                <option value="Discount">Discount Code</option>
                                <option value="Happy Hour">Happy Hour</option>
                                <option value="Seasonal">Seasonal Menu</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Form.PromoCode" class="form-label fw-bold">Promotion code (optional)</label>
                            <input asp-for="Form.PromoCode" class="form-control" maxlength="24" placeholder="e.g. WEEKEND20" data-promo-edit="0" />
                            <small class="text-muted">Codes are case-insensitive and must be unique. Leave blank for no-code campaigns.</small>
                            <span asp-validation-for="Form.PromoCode" class="text-danger small d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.DiscountType" class="form-label fw-bold">Discount Type</label>
                            <select asp-for="Form.DiscountType" class="form-select">
                                <option value="None">No monetary discount</option>
                                <option value="Percentage">Percentage (%)</option>
                                <option value="FixedAmount">Fixed Amount (RM)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.DiscountValue" class="form-label fw-bold">Discount Value</label>
                            <input asp-for="Form.DiscountValue" type="number" class="form-control" min="0" step="0.01" required />
                            <small class="text-muted">Enter 0 when the discount type is None.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.StartDate" class="form-label fw-bold">Start Date</label>
                            <input asp-for="Form.StartDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Form.EndDate" class="form-label fw-bold">End Date</label>
                            <input asp-for="Form.EndDate" type="date" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label asp-for="Form.Description" class="form-label fw-bold">Description and Rules</label>
                            <textarea asp-for="Form.Description" class="form-control" maxlength="1000" rows="3" required placeholder="Describe offer rules and applicable products or times..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Create Campaign</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
// Immediate duplicate-code feedback. The server and SQL unique index remain
// authoritative, including against two simultaneous submissions.
(() => {
    const currentCodes = Array.from(document.querySelectorAll('.promo-code-box'))
        .map(el => ({ id: Number(el.dataset.campaignId), code: (el.dataset.promoCode || '').trim().toUpperCase() }))
        .filter(c => c.code);
    document.querySelectorAll('input[name="Form.PromoCode"]').forEach(field => {
        const message = document.createElement('div');
        message.className = 'promo-field-error';
        message.setAttribute('role', 'status');
        field.insertAdjacentElement('afterend', message);
        const validate = () => {
            const value = field.value.trim().toUpperCase();
            const owner = Number(field.dataset.promoEdit || 0);
            const duplicate = value && currentCodes.some(c => c.id !== owner && c.code?.toUpperCase() === value);
            message.textContent = duplicate ? 'This promo code is already used. Choose a different code.' : '';
            message.classList.toggle('visible', !!duplicate);
            field.setCustomValidity(duplicate ? 'Promotion code already exists.' : '');
        };
        field.addEventListener('input', validate);
        field.addEventListener('blur', validate);
        field.form?.addEventListener('submit', validate);
    });
})();
</script>

@if (ViewData["ReopenCreateModal"] is true)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('addCampaignModal');
            if (modal && window.bootstrap) bootstrap.Modal.getOrCreateInstance(modal).show();
        });
    </script>
}
