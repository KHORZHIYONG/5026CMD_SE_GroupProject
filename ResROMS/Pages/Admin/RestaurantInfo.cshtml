@page "/Admin/RestaurantInfo"
@model ResROMS.Pages.Admin.RestaurantInfoModel
@{
    ViewData["Title"] = "Restaurant Setup";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Outfit', sans-serif;
                background-color: #f4f7f6;
                margin: 0;
                display: flex;
            }

            /* --- Sidebar Styles (Same as Dashboard) --- */
            .sidebar {
                width: 260px;
                background-color: #121418;
                min-height: 100vh;
                color: #fff;
                position: fixed;
                display: flex;
                flex-direction: column;
                z-index: 1000;
            }

            .sidebar-brand {
                padding: 20px;
                font-size: 1.8rem;
                font-weight: 700;
                text-align: center;
                background: linear-gradient(135deg, #e85d04, #fca311);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                border-bottom: 1px solid rgba(255,255,255,0.1);
                margin-bottom: 20px;
            }

            .nav-link {
                color: #a0aec0;
                padding: 12px 25px;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

                .nav-link:hover, .nav-link.active {
                    color: #ffffff;
                    background: rgba(255, 255, 255, 0.05);
                    border-left: 4px solid #e85d04;
                }

                .nav-link i {
                    font-size: 1.2rem;
                }

            /* --- Main Content Styles --- */
            .main-content {
                margin-left: 260px;
                flex-grow: 1;
                padding: 30px;
                width: calc(100% - 260px);
            }

            .page-title {
                font-size: 1.8rem;
                font-weight: 700;
                color: #2d3748;
                margin-bottom: 25px;
            }

            /* --- Tab Customization --- */
            .nav-tabs .nav-link {
                color: #718096;
                font-weight: 500;
                border: none;
                border-bottom: 3px solid transparent;
                padding: 12px 20px;
                margin-bottom: -1px;
            }

                .nav-tabs .nav-link:hover {
                    border-color: transparent;
                    color: #e85d04;
                }

                .nav-tabs .nav-link.active {
                    color: #e85d04;
                    background: transparent;
                    border-color: transparent;
                    border-bottom: 3px solid #e85d04;
                }

            .tab-card {
                background: #ffffff;
                border-radius: 0 0 12px 12px;
                border-top-right-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
                padding: 30px;
                border: none;
            }

            .form-label {
                font-weight: 600;
                color: #4a5568;
                font-size: 0.95rem;
            }

            .btn-primary-custom {
                background-color: #e85d04;
                border: none;
                padding: 10px 25px;
                font-weight: 600;
                border-radius: 8px;
            }

                .btn-primary-custom:hover {
                    background-color: #dc2f02;
                }
    </style>
</head>
<body>

    <!-- Sidebar Navigation -->
    <nav class="sidebar">
        <div class="sidebar-brand">ResROMS</div>
        <a href="/Admin/Dashboard" class="nav-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
        <a href="/Admin/RestaurantInfo" class="nav-link active"><i class="bi bi-shop"></i> Restaurant Setup</a>
        <a href="#" class="nav-link"><i class="bi bi-people-fill"></i> Accounts</a>
        <a href="#" class="nav-link"><i class="bi bi-journal-richtext"></i> Menu & Pricing</a>
        <a href="#" class="nav-link"><i class="bi bi-activity"></i> Live Monitor</a>
        <a href="#" class="nav-link"><i class="bi bi-bar-chart-fill"></i> Reports</a>
        <a href="#" class="nav-link"><i class="bi bi-megaphone-fill"></i> Campaigns</a>

        <div style="margin-top: auto; padding-bottom: 20px;">
            <a href="/Login" class="nav-link"><i class="bi bi-box-arrow-left"></i> Sign Out</a>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">

        <h1 class="page-title">Restaurant Setup</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Nav Tabs -->
        <ul class="nav nav-tabs" id="setupTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab">General Info</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="hours-tab" data-bs-toggle="tab" data-bs-target="#hours" type="button" role="tab">Operating Hours</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="areas-tab" data-bs-toggle="tab" data-bs-target="#areas" type="button" role="tab">Dining Areas & Tables</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button" role="tab">Menu Categories</button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content tab-card" id="setupTabsContent">

            <!-- 1. General Info Tab -->
            <div class="tab-pane fade show active" id="general" role="tabpanel">
                <h4 class="mb-4 text-dark fw-bold">Basic Information</h4>
                <form method="post">
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. The Rustic Spoon" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Phone" class="form-label"></label>
                            <input asp-for="Input.Phone" class="form-control" placeholder="e.g. +1 234 567 8900" />
                            <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="contact@restaurant.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <textarea asp-for="Input.Address" class="form-control" rows="3" placeholder="Full physical address"></textarea>
                            <span asp-validation-for="Input.Address" class="text-danger small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn text-white btn-primary-custom">Save Changes</button>
                </form>
            </div>

            <!-- 2. Operating Hours Tab (Mockup) -->
            <div class="tab-pane fade" id="hours" role="tabpanel">
                <h4 class="mb-4 text-dark fw-bold">Operating Hours</h4>
                <p class="text-muted mb-4">Set your standard opening and closing times. Leave fields blank if closed.</p>
                <div class="row align-items-center mb-3">
                    <div class="col-md-2 fw-bold">Monday</div>
                    <div class="col-md-3"><input type="time" class="form-control" value="09:00"></div>
                    <div class="col-md-1 text-center">to</div>
                    <div class="col-md-3"><input type="time" class="form-control" value="22:00"></div>
                </div>
                <div class="row align-items-center mb-3">
                    <div class="col-md-2 fw-bold">Tuesday</div>
                    <div class="col-md-3"><input type="time" class="form-control" value="09:00"></div>
                    <div class="col-md-1 text-center">to</div>
                    <div class="col-md-3"><input type="time" class="form-control" value="22:00"></div>
                </div>
                <!-- You can add the rest of the days here -->
                <button type="button" class="btn text-white btn-primary-custom mt-3">Update Hours</button>
            </div>

            <!-- 3. Dining Areas Tab (Mockup) -->
            <div class="tab-pane fade" id="areas" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-dark fw-bold mb-0">Dining Areas</h4>
                    <button class="btn btn-sm btn-outline-dark"><i class="bi bi-plus-lg"></i> Add New Area</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Area Name</th>
                                <th>Capacity</th>
                                <th>Total Tables</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Main Dining Room</td>
                                <td>80 pax</td>
                                <td>20</td>
                                <td>
                                    <button class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                            <tr>
                                <td>Outdoor Patio</td>
                                <td>40 pax</td>
                                <td>10</td>
                                <td>
                                    <button class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Menu Categories Tab (Mockup) -->
            <div class="tab-pane fade" id="categories" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-dark fw-bold mb-0">Menu Categories</h4>
                    <button class="btn btn-sm btn-outline-dark"><i class="bi bi-plus-lg"></i> Add Category</button>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-secondary p-2 fs-6">Appetizers</span>
                    <span class="badge bg-secondary p-2 fs-6">Main Course</span>
                    <span class="badge bg-secondary p-2 fs-6">Desserts</span>
                    <span class="badge bg-secondary p-2 fs-6">Beverages</span>
                    <span class="badge bg-secondary p-2 fs-6">Specials</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Bootstrap JS for Tabs and Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Validation Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>