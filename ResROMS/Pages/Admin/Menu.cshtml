@page "/Admin/Menu"
@model ResROMS.Pages.Admin.MenuModel
@{
    ViewData["Title"] = "Menu & Pricing";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        /* Category Filter Pills */
        .category-pill {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            color: #4a5568;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .category-pill:hover, .category-pill.active {
                background: #e85d04;
                color: #ffffff;
                border-color: #e85d04;
                box-shadow: 0 4px 12px rgba(232, 93, 4, 0.25);
            }

        /* Menu Item Cards */
        .menu-card {
            background: #ffffff;
            border-radius: 16px;
            border: none;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .menu-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            }

        .menu-card-img {
            height: 180px;
            width: 100%;
            object-fit: cover;
        }

        .menu-image-trigger{display:block;width:100%;padding:0;border:0;background:transparent;cursor:zoom-in}
        .menu-image-trigger:focus-visible{outline:3px solid #e85d04;outline-offset:-3px}
        .menu-grid-small .menu-item-card{width:50%;}
        @@media(min-width:768px){.menu-grid-small .menu-item-card{width:25%;}}
        @@media(min-width:1200px){.menu-grid-small .menu-item-card{width:16.6667%;}}
        .menu-grid-small .menu-card-img{height:125px}
        .menu-grid-small .menu-card .p-4{padding:.75rem!important}
        .menu-grid-small .menu-card h5{font-size:.95rem}
        .menu-grid-large .menu-item-card{width:100%}
        @@media(min-width:992px){.menu-grid-large .menu-item-card{width:50%}}
        .menu-grid-large .menu-card-img{height:265px}
        .item-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: #e85d04;
        }

        .badge-dietary {
            background: rgba(56, 161, 105, 0.15);
            color: #276749;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 12px;
        }

        .badge-out-of-stock {
            background: rgba(229, 62, 62, 0.15);
            color: #c53030;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
        }

        /* Custom Switch Styling */
        .form-check-input:checked {
            background-color: #e85d04;
            border-color: #e85d04;
        }

        .btn-primary-custom {
            background-color: #e85d04;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #dc2f02;
                color: white;
            }
    </style>
}

<!-- Required for secure POST requests from JavaScript -->
@Html.AntiForgeryToken()

<div class="page-header">
    <div>
        <h1 class="page-title">Menu & Pricing Management</h1>
        <p class="text-muted small mb-0">Create dishes, adjust prices, and toggle real-time kitchen availability.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#manageCategoriesModal">
            <i class="bi bi-pencil-square me-1"></i> Manage Categories
        </button>
        <button class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
            <i class="bi bi-folder-plus me-1"></i> Add Category
        </button>
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addItemModal">
            <i class="bi bi-plus-lg me-1"></i> Add Dish
        </button>
    </div>
</div>

@if (TempData["ErrorMessage"] is string menuError)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @menuError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Category Filters & Search -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex flex-wrap gap-2" id="categoryFilterPills">
        <button class="category-pill active" onclick="filterCategory(0, this)">All Items</button>
        @foreach (var cat in Model.Categories)
        {
            <button class="category-pill" onclick="filterCategory(@cat.Id, this)">@cat.Name</button>
        }
    </div>
    <div class="btn-group btn-group-sm" aria-label="Menu card size" id="menuViewSizes">
        <button type="button" class="btn btn-outline-secondary" data-view="small" aria-pressed="false">Small</button>
        <button type="button" class="btn btn-outline-secondary" data-view="medium" aria-pressed="true">Medium</button>
        <button type="button" class="btn btn-outline-secondary" data-view="large" aria-pressed="false">Large</button>
    </div>
    <div class="input-group" style="max-width: 280px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" id="menuSearchInput" class="form-control border-start-0 ps-0" placeholder="Search dish..." onkeyup="searchMenu()">
    </div>
</div>

<!-- Menu Items Grid -->
<div class="row g-4" id="menuGrid">
    @foreach (var item in Model.MenuItems)
    {
        <div class="col-12 col-md-6 col-lg-4 menu-item-card" data-category-id="@item.CategoryId" data-name="@item.Name.ToLower()">
            <div class="menu-card">
                <div class="position-relative">
                    <button type="button" class="menu-image-trigger" data-bs-toggle="modal" data-bs-target="#dishImageModal" aria-label="Enlarge image of @item.Name" onclick="previewDish(this)">
                        <img src="@item.ImageUrl" class="menu-card-img" alt="@item.Name" onerror="this.onerror=null;this.src='https://placehold.co/500x300?text=No+Image';" />
                    </button>
                    <div class="position-absolute top-0 end-0 p-3 d-flex gap-1">
                        @if (!string.IsNullOrEmpty(item.DietaryTag))
                        {
                            <span class="badge-dietary">@item.DietaryTag</span>
                        }
                        @if (!item.IsAvailable)
                        {
                            <span class="badge-out-of-stock">Sold Out</span>
                        }
                    </div>
                </div>

                <div class="p-4 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="fw-bold text-dark mb-0">@item.Name</h5>
                        <span class="item-price">RM @item.Price.ToString("F2")</span>
                    </div>

                    <p class="text-muted small mb-3 flex-grow-1">@item.Description</p>

                    <hr class="my-2 border-light">

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <!-- Quick Availability Switch (Now with onchange event!) -->
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="switch-@item.Id" @(item.IsAvailable ? "checked" : "") onchange="toggleAvailability(@item.Id, this)">
                            <label class="form-check-label small text-muted" for="switch-@item.Id">Available</label>
                        </div>

                        <!-- Dropdown Actions -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <!-- We wrap the dropdown in a form so the Delete button can submit securely -->
                            <form method="post" class="m-0 p-0">
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <button type="button" class="dropdown-item small"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-price="@item.Price"
                                                data-category="@item.CategoryId"
                                                data-dietary="@item.DietaryTag"
                                                data-image="@item.ImageUrl"
                                                data-description="@item.Description"
                                                onclick="openEditModal(this)">
                                            <i class="bi bi-pencil me-2"></i>Edit Dish
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <!-- Delete button triggers OnPostDeleteMenuItemAsync in C# -->
                                        <button type="submit" asp-page-handler="DeleteMenuItem" asp-route-id="@item.Id" class="dropdown-item small text-danger" onclick="return confirm('Are you sure you want to permanently delete @item.Name?');">
                                            <i class="bi bi-trash me-2"></i>Remove
                                        </button>
                                    </li>
                                </ul>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add Menu Item -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add New Menu Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddMenuItem" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Dish Name</label>
                            <input asp-for="NewMenuItem.Name" maxlength="120" class="form-control" placeholder="e.g. Wagyu Beef Burger" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Price (RM)</label>
                            <input asp-for="NewMenuItem.Price" type="number" min="0.01" max="99999.99" step="0.01" class="form-control" placeholder="18.50" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Category</label>
                            <select asp-for="NewMenuItem.CategoryId" class="form-select" required>
                                <option value="">Choose a category</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dietary Tag (Optional)</label>
                            <select asp-for="NewMenuItem.DietaryTag" class="form-select">
                                <option value="">None</option>
                                <option value="Vegetarian">Vegetarian</option>
                                <option value="Vegan">Vegan</option>
                                <option value="Gluten-Free">Gluten-Free</option>
                                <option value="Spicy">Spicy</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Image URL</label>
                            <input asp-for="NewMenuItem.ImageUrl" maxlength="2048" class="form-control" placeholder="https://images.unsplash.com/..." />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Description</label>
                            <textarea asp-for="NewMenuItem.Description" maxlength="2000" class="form-control" rows="3" placeholder="Briefly describe the ingredients and preparation..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Add Dish</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Menu Item -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Edit Menu Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="EditMenuItem" method="post">
                <!-- Hidden ID field so the database knows which item to update -->
                <input type="hidden" asp-for="EditMenuItem.Id" id="editItemId" />

                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Dish Name</label>
                            <input asp-for="EditMenuItem.Name" maxlength="120" id="editItemName" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Price (RM)</label>
                            <input asp-for="EditMenuItem.Price" id="editItemPrice" type="number" min="0.01" max="99999.99" step="0.01" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Category</label>
                            <select asp-for="EditMenuItem.CategoryId" id="editItemCategory" class="form-select" required>
                                <option value="">Choose a category</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dietary Tag</label>
                            <select asp-for="EditMenuItem.DietaryTag" id="editItemDietary" class="form-select">
                                <option value="">None</option>
                                <option value="Vegetarian">Vegetarian</option>
                                <option value="Vegan">Vegan</option>
                                <option value="Gluten-Free">Gluten-Free</option>
                                <option value="Spicy">Spicy</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Image URL</label>
                            <input asp-for="EditMenuItem.ImageUrl" maxlength="2048" id="editItemImage" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Description</label>
                            <textarea asp-for="EditMenuItem.Description" maxlength="2000" id="editItemDescription" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="dishImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="dishImageTitle">Dish image</h5><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body text-center"><img id="dishImageExpanded" alt="Selected dish" class="img-fluid rounded" style="max-height:75vh;object-fit:contain" /></div>
    </div></div>
</div>

<!-- Modal: Add Category -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddCategory" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Category Name</label>
                        <input asp-for="NewCategory.Name" maxlength="80" class="form-control" placeholder="e.g. Cocktails & Drinks" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Modal: Manage Categories. A category with dishes cannot be deleted. -->
<div class="modal fade" id="manageCategoriesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Manage Menu Categories</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Rename categories or delete empty categories. Move dishes to another category before deletion.</p>
                @if (!Model.Categories.Any())
                {
                    <p class="text-muted">No categories yet.</p>
                }
                @foreach (var cat in Model.Categories)
                {
                    <div class="row g-2 align-items-center mb-3">
                        <div class="col-12 col-md-9">
                            <form id="rename-category-@cat.Id" asp-page-handler="RenameCategory" asp-route-id="@cat.Id" method="post" class="d-flex gap-2">
                                <input type="text" name="RenameCategory.Name" value="@cat.Name" maxlength="80" required class="form-control" aria-label="New name for @cat.Name" />
                                <button type="submit" class="btn btn-outline-primary text-nowrap">Rename</button>
                            </form>
                        </div>
                        <div class="col-12 col-md-3">
                            <form asp-page-handler="DeleteCategory" asp-route-id="@cat.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger w-100"
                                        onclick="return confirm('Delete this category? Dishes must be reassigned first.');">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!string.IsNullOrEmpty(Model.ActiveModal))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modal = document.getElementById('@Model.ActiveModal');
                if (modal) bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        </script>
    }
    <script>
        // View sizes are a visual preference only.
        (() => {
            const grid = document.getElementById('menuGrid');
            const controls = document.getElementById('menuViewSizes');
            const key = 'ResROMS.Admin.MenuView';
            const apply = value => {
                if (!['small','medium','large'].includes(value)) value = 'medium';
                grid.classList.toggle('menu-grid-small', value === 'small');
                grid.classList.toggle('menu-grid-large', value === 'large');
                controls.querySelectorAll('[data-view]').forEach(btn => {
                    const selected = btn.dataset.view === value;
                    btn.classList.toggle('active', selected);
                    btn.setAttribute('aria-pressed', String(selected));
                });
                try { localStorage.setItem(key, value); } catch { }
            };
            try { apply(localStorage.getItem(key) || 'medium'); } catch { apply('medium'); }
            controls.addEventListener('click', e => {
                const btn = e.target.closest('[data-view]');
                if (btn) apply(btn.dataset.view);
            });
        })();
        function previewDish(button) {
            const thumbnail = button.querySelector('img');
            const expanded = document.getElementById('dishImageExpanded');
            expanded.src = thumbnail.currentSrc || thumbnail.src;
            expanded.alt = thumbnail.alt;
            document.getElementById('dishImageTitle').textContent = thumbnail.alt;
        }
        // Category Filter Function
        function filterCategory(categoryId, element) {
            document.querySelectorAll('#categoryFilterPills .category-pill').forEach(pill => pill.classList.remove('active'));
            element.classList.add('active');

            const cards = document.querySelectorAll('#menuGrid .menu-item-card');
            cards.forEach(card => {
                if (categoryId === 0 || card.getAttribute('data-category-id') == categoryId) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Real-time Search Filter
        function searchMenu() {
            const query = document.getElementById('menuSearchInput').value.toLowerCase();
            const cards = document.querySelectorAll('#menuGrid .menu-item-card');

            cards.forEach(card => {
                const name = card.getAttribute('data-name');
                if (name.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Real-time Database Toggle Function
        async function toggleAvailability(itemId, checkbox) {
            const isAvailable = checkbox.checked;

            // Get the security token generated by ASP.NET
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenElement ? tokenElement.value : '';

            try {
                // Send a POST request to the OnPostToggleAvailabilityAsync method in your C# file
                const response = await fetch(`?handler=ToggleAvailability&id=${itemId}&isAvailable=${isAvailable}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                if (!response.ok) {
                    throw new Error("Failed to update database.");
                }

                console.log(`Dish ${itemId} availability changed to ${isAvailable}`);

            } catch (error) {
                alert("Error saving to database. Reverting switch.");
                // Revert the switch visually if the database save fails
                checkbox.checked = !isAvailable;
            }
        }

        // Populates and opens the Edit Modal
        function openEditModal(button) {
            // Get data from the clicked button
            document.getElementById('editItemId').value = button.getAttribute('data-id');
            document.getElementById('editItemName').value = button.getAttribute('data-name');

            // Format price properly (removes trailing zeroes if necessary)
            let price = parseFloat(button.getAttribute('data-price')).toFixed(2);
            document.getElementById('editItemPrice').value = price;

            document.getElementById('editItemCategory').value = button.getAttribute('data-category');
            document.getElementById('editItemDietary').value = button.getAttribute('data-dietary') || "";
            document.getElementById('editItemImage').value = button.getAttribute('data-image') || "";
            document.getElementById('editItemDescription').value = button.getAttribute('data-description') || "";

            // Show the modal using Bootstrap's JS API
            var editModal = new bootstrap.Modal(document.getElementById('editItemModal'));
            editModal.show();
        }
    </script>
}