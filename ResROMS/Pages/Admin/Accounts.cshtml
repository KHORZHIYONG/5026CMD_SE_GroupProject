@page "/Admin/Accounts"
@model ResROMS.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Account & Staff Management";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        /* KPI Cards */
        .kpi-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: none;
        }

        /* Filter Pills */
        .role-pill {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            color: #4a5568;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .role-pill:hover, .role-pill.active {
                background: #e85d04;
                color: #ffffff;
                border-color: #e85d04;
                box-shadow: 0 4px 12px rgba(232, 93, 4, 0.25);
            }

        /* Role Badges */
        .badge-admin {
            background: rgba(128, 90, 213, 0.15);
            color: #6b46c1;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 20px;
        }

        .badge-kitchen {
            background: rgba(49, 130, 206, 0.15);
            color: #2b6cb0;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 20px;
        }

        .badge-waiter {
            background: rgba(56, 161, 105, 0.15);
            color: #276749;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 20px;
        }

        .badge-customer {
            background: rgba(160, 174, 192, 0.15);
            color: #4a5568;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 20px;
        }

        /* Avatar Circle */
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #4a5568;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary-custom {
            background-color: #e85d04;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #dc2f02;
                color: white;
            }

        .form-check-input:checked {
            background-color: #e85d04;
            border-color: #e85d04;
        }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Account Management</h1>
        <p class="text-muted small mb-0">Manage staff roles, customer profiles, permissions, and security status.</p>
    </div>
    <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="bi bi-person-plus-fill me-1"></i> Add New Account
    </button>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="text-muted small fw-bold text-uppercase">Total Users</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.Users.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="text-muted small fw-bold text-uppercase">Active Staff</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.Users.Count(u => u.Role != "Customer" && u.IsActive)</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="text-muted small fw-bold text-uppercase">Kitchen Team</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.Users.Count(u => u.Role == "Kitchen Staff")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="kpi-card">
            <div class="text-muted small fw-bold text-uppercase">Registered Customers</div>
            <div class="fs-2 fw-bold text-secondary mt-1">@Model.Users.Count(u => u.Role == "Customer")</div>
        </div>
    </div>
</div>

<!-- Filters and Search -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex flex-wrap gap-2" id="roleFilterPills">
        <button class="role-pill active" onclick="filterRole('All', this)">All Accounts</button>
        <button class="role-pill" onclick="filterRole('Admin', this)">Admins</button>
        <button class="role-pill" onclick="filterRole('Kitchen Staff', this)">Kitchen Staff</button>
        <button class="role-pill" onclick="filterRole('Waiter', this)">Waiters</button>
        <button class="role-pill" onclick="filterRole('Customer', this)">Customers</button>
    </div>

    <div class="input-group" style="max-width: 300px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" id="userSearchInput" class="form-control border-start-0 ps-0" placeholder="Search name or email..." onkeyup="searchUsers()">
    </div>
</div>

<!-- Users Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable">
            <thead class="table-light">
                <tr class="text-muted small text-uppercase">
                    <th class="ps-4">User</th>
                    <th>Contact</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last Active</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var roleBadgeClass = user.Role switch
                    {
                        "Admin" => "badge-admin",
                        "Kitchen Staff" => "badge-kitchen",
                        "Waiter" => "badge-waiter",
                        _ => "badge-customer"
                    };

                    var initials = string.Concat(user.FullName.Split(' ').Select(n => n[0]));

                    <tr class="user-row" data-role="@user.Role" data-search="@user.FullName.ToLower() @user.Email.ToLower()">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar">@initials</div>
                                <div>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <div class="text-muted small">Joined @user.DateJoined.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">@user.Email</div>
                            <div class="small text-muted">@user.Phone</div>
                        </td>
                        <td>
                            <span class="@roleBadgeClass">@user.Role</span>
                        </td>
                        <td>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="status-@user.Id" @(user.IsActive ? "checked" : "")>
                                <label class="form-check-label small" for="status-@user.Id">
                                    @(user.IsActive ? "Active" : "Disabled")
                                </label>
                            </div>
                        </td>
                        <td class="small text-muted">@user.LastLogin</td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light rounded-circle" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item small" href="#"><i class="bi bi-pencil me-2"></i>Edit Details</a></li>
                                    <li><a class="dropdown-item small" href="#"><i class="bi bi-key me-2"></i>Reset Password</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item small text-danger" href="#"><i class="bi bi-person-x me-2"></i>Deactivate Account</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Add New Account -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Create Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddUser" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <input asp-for="NewUser.FullName" class="form-control" placeholder="e.g. Robert Vance" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input asp-for="NewUser.Email" type="email" class="form-control" placeholder="robert@resroms.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input asp-for="NewUser.Phone" class="form-control" placeholder="+1 555-0123" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Account Role</label>
                        <select asp-for="NewUser.Role" class="form-select" required>
                            <option value="Admin">Administrator</option>
                            <option value="Kitchen Staff">Kitchen Staff</option>
                            <option value="Waiter">Waiter / Host</option>
                            <option value="Customer">Customer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Temporary Password</label>
                        <input asp-for="NewUser.TemporaryPassword" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Role Filtering Function
        function filterRole(role, element) {
            document.querySelectorAll('#roleFilterPills .role-pill').forEach(pill => pill.classList.remove('active'));
            element.classList.add('active');

            const rows = document.querySelectorAll('#usersTable .user-row');
            rows.forEach(row => {
                const userRole = row.getAttribute('data-role');
                if (role === 'All' || userRole === role) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Live Search Function
        function searchUsers() {
            const query = document.getElementById('userSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#usersTable .user-row');

            rows.forEach(row => {
                const searchContent = row.getAttribute('data-search');
                if (searchContent.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}