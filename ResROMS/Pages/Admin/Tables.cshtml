@page "/Admin/Tables"
@model ResROMS.Pages.Admin.TablesModel
@{
    ViewData["Title"] = "Floor Layout & Tables";
}

@section Styles {
    <style>
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .page-title { font-size: 1.8rem; font-weight: 700; color: #2d3748; margin: 0; }

        /* Area Filter Pills */
        .area-pill { background: #ffffff; border: 1px solid #e2e8f0; color: #4a5568; font-weight: 600; padding: 10px 20px; border-radius: 30px; cursor: pointer; transition: all 0.2s; }
        .area-pill:hover, .area-pill.active { background: #e85d04; color: #ffffff; border-color: #e85d04; box-shadow: 0 4px 12px rgba(232, 93, 4, 0.25); }

        /* Status Legend */
        .legend-dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; margin-right: 6px; }

        /* Table Cards Grid */
        .table-card { background: #ffffff; border-radius: 16px; border: 2px solid transparent; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.2s ease; position: relative; }
        .table-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }

        /* Status Variants */
        .status-available { border-color: #38a169; }
        .status-occupied { border-color: #e85d04; }
        .status-reserved { border-color: #d69e2e; }
        .status-maintenance { border-color: #a0aec0; background: #f8fafc; }

        .status-badge { font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; }
        .badge-available { background: rgba(56, 161, 105, 0.15); color: #276749; }
        .badge-occupied { background: rgba(232, 93, 4, 0.15); color: #c05621; }
        .badge-reserved { background: rgba(214, 158, 46, 0.15); color: #975a16; }
        .badge-maintenance { background: rgba(160, 174, 192, 0.15); color: #4a5568; }

        .table-visual { width: 70px; height: 70px; border-radius: 12px; background: #edf2f7; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 15px auto; font-weight: 700; color: #2d3748; }
        .table-visual.round { border-radius: 50%; }

        .btn-primary-custom { background-color: #e85d04; border: none; font-weight: 600; border-radius: 8px; color: white; }
        .btn-primary-custom:hover { background-color: #dc2f02; color: white; }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dining Areas & Tables</h1>
        <p class="text-muted small mb-0">Manage dining floor plans, seat capacities, and real-time availability.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#addAreaModal">
            <i class="bi bi-folder-plus me-1"></i> Add Area
        </button>
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addTableModal">
            <i class="bi bi-plus-lg me-1"></i> Add Table
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Area Filters & Legend Row -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <!-- Area Filter Pills -->
    <div class="d-flex flex-wrap gap-2" id="areaFilterPills">
        <button class="area-pill active" onclick="filterArea(0, this)">All Areas</button>
        @foreach (var area in Model.DiningAreas)
        {
            <button class="area-pill" onclick="filterArea(@area.Id, this)">@area.Name</button>
        }
    </div>

    <!-- Live Legend -->
    <div class="d-flex gap-3 bg-white px-3 py-2 rounded-3 shadow-sm text-secondary small font-weight-bold">
        <span><span class="legend-dot" style="background: #38a169;"></span> Available</span>
        <span><span class="legend-dot" style="background: #e85d04;"></span> Occupied</span>
        <span><span class="legend-dot" style="background: #d69e2e;"></span> Reserved</span>
        <span><span class="legend-dot" style="background: #a0aec0;"></span> Offline</span>
    </div>
</div>

<!-- Tables Layout Grid -->
<div class="row g-4" id="tablesGrid">
    @foreach (var table in Model.Tables)
    {
        var statusClass = table.Status switch
        {
            "Available" => "status-available",
            "Occupied" => "status-occupied",
            "Reserved" => "status-reserved",
            _ => "status-maintenance"
        };

        var badgeClass = table.Status switch
        {
            "Available" => "badge-available",
            "Occupied" => "badge-occupied",
            "Reserved" => "badge-reserved",
            _ => "badge-maintenance"
        };

        <div class="col-6 col-md-4 col-lg-3 table-item" data-area-id="@table.AreaId">
            <div class="table-card @statusClass">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="status-badge @badgeClass">@table.Status</span>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item small" href="#"><i class="bi bi-pencil me-2"></i>Edit Table</a></li>
                            <li><a class="dropdown-item small" href="#"><i class="bi bi-arrow-repeat me-2"></i>Change Status</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item small text-danger" href="#"><i class="bi bi-trash me-2"></i>Delete</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Graphic Icon representing shape -->
                <div class="table-visual @(table.Shape.ToLower() == "round" ? "round" : "")">
                    <i class="bi bi-grid-fill text-muted mb-1 fs-5"></i>
                    <span class="small">@table.TableNumber</span>
                </div>

                <div class="text-center">
                    <div class="fw-bold text-dark">@table.TableNumber</div>
                    <div class="text-muted small"><i class="bi bi-person-fill me-1"></i>@table.Capacity Seats</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add New Table -->
<div class="modal fade" id="addTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add New Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddTable" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Table Name/Number</label>
                        <input asp-for="NewTable.TableNumber" class="form-control" placeholder="e.g. T-12" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Seating Capacity</label>
                        <input asp-for="NewTable.Capacity" type="number" min="1" max="20" class="form-control" value="4" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Dining Area</label>
                        <select asp-for="NewTable.AreaId" class="form-select" required>
                            @foreach (var area in Model.DiningAreas)
                            {
                                <option value="@area.Id">@area.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Table Shape</label>
                        <select asp-for="NewTable.Shape" class="form-select">
                            <option value="Square">Square</option>
                            <option value="Round">Round</option>
                            <option value="Rectangle">Rectangle</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Create Table</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Dining Area -->
<div class="modal fade" id="addAreaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Dining Area</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-page-handler="AddArea" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Area Name</label>
                        <input asp-for="NewArea.Name" class="form-control" placeholder="e.g. Rooftop Terrace" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-custom">Save Area</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Simple JS Area Filter Functionality
        function filterArea(areaId, element) {
            // Update pill styling
            document.querySelectorAll('#areaFilterPills .area-pill').forEach(pill => pill.classList.remove('active'));
            element.classList.add('active');

            // Filter grid items
            const cards = document.querySelectorAll('#tablesGrid .table-item');
            cards.forEach(card => {
                if (areaId === 0 || card.getAttribute('data-area-id') == areaId) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}