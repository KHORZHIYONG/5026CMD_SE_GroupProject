@page "/Admin/Tables"
@model ResROMS.Pages.Admin.TablesModel
@{
    ViewData["Title"] = "Floor Layout & Tables";
}

@section Styles {
    <style>
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .page-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d3748;
            margin: 0;
        }

        /* Area Filter Pills */
        .area-pill {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            color: #4a5568;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .area-pill:hover, .area-pill.active {
                background: #e85d04;
                color: #ffffff;
                border-color: #e85d04;
                box-shadow: 0 4px 12px rgba(232, 93, 4, 0.25);
            }

        /* Status Legend */
        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }

        /* Table Cards Grid */
        .table-card {
            background: #ffffff;
            border-radius: 16px;
            border: 2px solid transparent;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: all 0.2s ease;
            position: relative;
        }

            .table-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            }

        /* Status Variants */
        .status-available {
            border-color: #38a169;
        }

        .status-occupied {
            border-color: #e85d04;
        }

        .status-reserved {
            border-color: #d69e2e;
        }

        .status-maintenance {
            border-color: #a0aec0;
            background: #f8fafc;
        }

        .status-badge {
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 20px;
            text-transform: uppercase;
        }

        .badge-available {
            background: rgba(56, 161, 105, 0.15);
            color: #276749;
        }

        .badge-occupied {
            background: rgba(232, 93, 4, 0.15);
            color: #c05621;
        }

        .badge-reserved {
            background: rgba(214, 158, 46, 0.15);
            color: #975a16;
        }

        .badge-maintenance {
            background: rgba(160, 174, 192, 0.15);
            color: #4a5568;
        }

        .table-visual {
            width: 70px;
            height: 70px;
            border-radius: 12px;
            background: #edf2f7;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 15px auto;
            font-weight: 700;
            color: #2d3748;
        }

            .table-visual.round {
                border-radius: 50%;
            }

        .btn-primary-custom {
            background-color: #e85d04;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            color: white;
        }

            .btn-primary-custom:hover {
                background-color: #dc2f02;
                color: white;
            }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dining Areas &amp; Tables</h1>
        <p class="text-muted small mb-0">Manage dining floor plans, seat capacities, and availability.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#manageAreasModal">
            <i class="bi bi-pencil-square me-1"></i> Manage Areas
        </button>
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#addAreaModal">
            <i class="bi bi-folder-plus me-1"></i> Add Area
        </button>
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#batchTablesModal" disabled="@(Model.DiningAreas.Count == 0)">
            <i class="bi bi-grid-3x3-gap me-1"></i> Bulk Add Tables
        </button>
        <button type="button" class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#addTableModal"
                disabled="@(Model.DiningAreas.Count == 0)">
            <i class="bi bi-plus-lg me-1"></i> Add Table
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" asp-validation-summary="All"></div>
}

<div id="pageState" data-active-modal="@Model.ActiveModal" hidden></div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex flex-wrap gap-2" id="areaFilterPills">
        <button type="button" class="area-pill active" onclick="filterArea(0, this)">All Areas</button>
        @foreach (var area in Model.DiningAreas)
        {
            <button type="button" class="area-pill" onclick="filterArea(@area.Id, this)">@area.Name (@area.TableCount)</button>
        }
    </div>
    <div class="d-flex gap-3 bg-white px-3 py-2 rounded-3 shadow-sm text-secondary small">
        <span><span class="legend-dot" style="background: #38a169;"></span>Available</span>
        <span><span class="legend-dot" style="background: #e85d04;"></span>Occupied</span>
        <span><span class="legend-dot" style="background: #d69e2e;"></span>Reserved</span>
        <span><span class="legend-dot" style="background: #a0aec0;"></span>Maintenance</span>
    </div>
</div>

@if (Model.Tables.Count == 0)
{
    <div class="alert alert-info">No tables are stored yet. Add a dining area, then add your first table.</div>
}
<div class="row g-4" id="tablesGrid">
    @foreach (var table in Model.Tables)
    {
        var statusClass = table.Status switch
        {
            "Available" => "status-available",
            "Occupied" => "status-occupied",
            "Reserved" => "status-reserved",
            _ => "status-maintenance"
        };
        var badgeClass = table.Status switch
        {
            "Available" => "badge-available",
            "Occupied" => "badge-occupied",
            "Reserved" => "badge-reserved",
            _ => "badge-maintenance"
        };

        <div class="col-6 col-md-4 col-lg-3 table-item" data-area-id="@table.DiningAreaId">
            <div class="table-card @statusClass">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="status-badge @badgeClass">@table.Status</span>
                    <div class="dropdown">
                        <button type="button" class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown" aria-label="Table actions">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-2 shadow-sm" style="min-width: 230px;">
                            <button type="button" class="dropdown-item small" data-bs-toggle="modal"
                                    data-bs-target="#editTableModal" data-table-id="@table.Id"
                                    data-number="@table.TableNumber" data-capacity="@table.Capacity"
                                    data-area="@table.DiningAreaId" data-shape="@table.Shape">
                                <i class="bi bi-pencil me-2"></i>Edit Table
                            </button>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-page-handler="UpdateStatus">
                                <input type="hidden" name="id" value="@table.Id" />
                                <label class="small fw-bold" for="status-@table.Id">Change Status</label>
                                <select class="form-select form-select-sm my-1" id="status-@table.Id" name="newStatus">
                                    @foreach (var status in new[] { "Available", "Occupied", "Reserved", "Maintenance" })
                                    {
                                        <option value="@status" selected="@(status == table.Status)">@status</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-dark w-100" type="submit">Update Status</button>
                            </form>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-page-handler="DeleteTable" onsubmit="return confirm('Delete this table?');">
                                <input type="hidden" name="id" value="@table.Id" />
                                <button class="dropdown-item small text-danger" type="submit">
                                    <i class="bi bi-trash me-2"></i>Delete Table
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="table-visual @(table.Shape == "Round" ? "round" : "")">
                    <i class="bi bi-grid-fill text-muted mb-1 fs-5"></i>
                    <span class="small">@table.TableNumber</span>
                </div>
                <div class="text-center">
                    <div class="fw-bold text-dark">@table.TableNumber</div>
                    <div class="text-muted small"><i class="bi bi-person-fill me-1"></i>@table.Capacity Seats</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="addTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title fw-bold">Add New Table</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <form method="post" asp-page-handler="AddTable">
            <div class="modal-body">
                <div class="mb-3"><label asp-for="NewTable.TableNumber" class="form-label fw-bold">Table Number</label>
                    <input asp-for="NewTable.TableNumber" class="form-control" placeholder="e.g. T-12" required maxlength="20" /></div>
                <div class="mb-3"><label asp-for="NewTable.Capacity" class="form-label fw-bold">Seating Capacity</label>
                    <input asp-for="NewTable.Capacity" class="form-control" type="number" min="1" max="20" required /></div>
                <div class="mb-3"><label asp-for="NewTable.DiningAreaId" class="form-label fw-bold">Dining Area</label>
                    <select asp-for="NewTable.DiningAreaId" class="form-select" required>
                        <option value="0">Select a dining area</option>
                        @foreach (var area in Model.DiningAreas)
                        {
                            <option value="@area.Id">@area.Name</option>
                        }
                    </select></div>
                <div class="mb-3"><label asp-for="NewTable.Shape" class="form-label fw-bold">Table Shape</label>
                    <select asp-for="NewTable.Shape" class="form-select">
                        <option value="Square">Square</option><option value="Round">Round</option>
                        <option value="Rectangle">Rectangle</option>
                    </select></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-custom">Create Table</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="batchTablesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title fw-bold">Create Multiple Tables</h5>
            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <form method="post" asp-page-handler="AddBatch">
            <div class="modal-body">
                <p class="text-muted small">Example: prefix <strong>T</strong>, start <strong>6</strong>, count <strong>5</strong> creates T-06 to T-10. All tables get the same area, capacity and shape. If any number exists, nothing is added.</p>
                <div class="row g-3">
                    <div class="col-5"><label asp-for="Batch.Prefix" class="form-label">Prefix</label><input asp-for="Batch.Prefix" class="form-control" maxlength="12" required /></div>
                    <div class="col-3"><label asp-for="Batch.StartNumber" class="form-label">Start</label><input asp-for="Batch.StartNumber" type="number" min="1" max="999" class="form-control" /></div>
                    <div class="col-4"><label asp-for="Batch.Count" class="form-label">Quantity</label><input asp-for="Batch.Count" type="number" min="1" max="40" class="form-control" /></div>
                    <div class="col-6"><label asp-for="Batch.Capacity" class="form-label">Seats each</label><input asp-for="Batch.Capacity" type="number" min="1" max="20" class="form-control" /></div>
                    <div class="col-6"><label asp-for="Batch.Shape" class="form-label">Shape</label><select asp-for="Batch.Shape" class="form-select"><option>Square</option><option>Round</option><option>Rectangle</option></select></div>
                    <div class="col-12"><label asp-for="Batch.DiningAreaId" class="form-label">Dining area</label><select asp-for="Batch.DiningAreaId" class="form-select" required><option value="0">Select area</option>
                        @foreach (var area in Model.DiningAreas) { <option value="@area.Id">@area.Name</option> }
                    </select></div>
                </div>
                <div asp-validation-summary="All" class="text-danger small mt-2"></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary-custom">Create Tables</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="addAreaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title fw-bold">Add Dining Area</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <form method="post" asp-page-handler="AddArea">
            <div class="modal-body"><label asp-for="NewArea.Name" class="form-label fw-bold">Area Name</label>
                <input asp-for="NewArea.Name" class="form-control" maxlength="80" placeholder="e.g. Rooftop Terrace" required /></div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-custom">Save Area</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="editTableModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title fw-bold">Edit Table</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <form method="post" asp-page-handler="EditTable">
            <input type="hidden" name="id" id="editTableId" />
            <div class="modal-body">
                <div class="mb-3"><label class="form-label fw-bold" for="editTableNumber">Table Number</label>
                    <input class="form-control" type="text" id="editTableNumber" name="EditTable.TableNumber" maxlength="20" required /></div>
                <div class="mb-3"><label class="form-label fw-bold" for="editTableCapacity">Capacity</label>
                    <input class="form-control" type="number" id="editTableCapacity" name="EditTable.Capacity" min="1" max="20" required /></div>
                <div class="mb-3"><label class="form-label fw-bold" for="editTableArea">Dining Area</label>
                    <select class="form-select" id="editTableArea" name="EditTable.DiningAreaId" required>
                        @foreach (var area in Model.DiningAreas)
                        {
                            <option value="@area.Id">@area.Name</option>
                        }
                    </select></div>
                <div class="mb-3"><label class="form-label fw-bold" for="editTableShape">Shape</label>
                    <select class="form-select" id="editTableShape" name="EditTable.Shape">
                        <option value="Square">Square</option><option value="Round">Round</option>
                        <option value="Rectangle">Rectangle</option>
                    </select></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary-custom">Save Changes</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="manageAreasModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h5 class="modal-title fw-bold">Manage Dining Areas</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            @foreach (var area in Model.DiningAreas)
            {
                <div class="border rounded p-3 mb-2">
                    <div class="small text-muted mb-2">@area.TableCount table(s)</div>
                    <form method="post" asp-page-handler="RenameArea" class="d-flex flex-wrap gap-2 mb-2">
                        <input type="hidden" name="id" value="@area.Id" />
                        <input type="text" class="form-control flex-grow-1" style="width: 180px;" name="RenameArea.Name"
                               value="@area.Name" maxlength="80" required aria-label="Rename dining area" />
                        <button type="submit" class="btn btn-outline-dark">Rename</button>
                    </form>
                    <form method="post" asp-page-handler="DeleteArea" onsubmit="return confirm('Delete this empty dining area?');">
                        <input type="hidden" name="id" value="@area.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(area.TableCount > 0)">Delete Area</button>
                    </form>
                </div>
            }
            @if (Model.DiningAreas.Count == 0)
            {
                <p class="text-muted">No dining areas yet.</p>
            }
            <p class="small text-muted mb-0">An area must be empty before it can be deleted.</p>
        </div>
    </div></div>
</div>

@section Scripts {
    <script>
        function filterArea(areaId, element) {
            document.querySelectorAll('#areaFilterPills .area-pill')
                .forEach(pill => pill.classList.remove('active'));
            element.classList.add('active');
            document.querySelectorAll('#tablesGrid .table-item').forEach(card => {
                card.style.display = areaId === 0 || card.dataset.areaId === String(areaId) ? '' : 'none';
            });
        }

        document.getElementById('editTableModal').addEventListener('show.bs.modal', event => {
            const trigger = event.relatedTarget;
            if (!trigger) return;
            document.getElementById('editTableId').value = trigger.dataset.tableId;
            document.getElementById('editTableNumber').value = trigger.dataset.number;
            document.getElementById('editTableCapacity').value = trigger.dataset.capacity;
            document.getElementById('editTableArea').value = trigger.dataset.area;
            document.getElementById('editTableShape').value = trigger.dataset.shape;
        });

        const activeModalId = document.getElementById('pageState')?.dataset.activeModal;
        if (activeModalId) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById(activeModalId)).show();
        }
    </script>
}
