@page
@model ResROMS.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS</title>

    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
            body {
                font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #f8f9fa;
                margin: 0;
                overflow-x: hidden;
            }

            /* Split Screen Layout */
            .login-container {
                min-height: 100vh;
            }

            /* Left Side: Image / Branding */
            .login-banner {
                background: linear-gradient(135deg, rgba(13,110,253,0.85) 0%, rgba(11,94,215,0.95) 100%), url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1200') center/cover no-repeat;
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 4rem;
            }

            .banner-title {
                font-size: 3rem;
                font-weight: 700;
                margin-bottom: 1rem;
                letter-spacing: -1px;
            }

            .banner-subtitle {
                font-size: 1.1rem;
                font-weight: 300;
                opacity: 0.9;
                max-width: 400px;
            }

            /* Right Side: Form Container */
            .login-form-wrapper {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem;
                background-color: #ffffff;
            }

            .login-card {
                width: 100%;
                max-width: 420px;
            }

            .login-heading {
                font-weight: 700;
                color: #212529;
                margin-bottom: 0.5rem;
                font-size: 2rem;
            }

            .login-subheading {
                color: #6c757d;
                margin-bottom: 2.5rem;
            }

            /* Upgraded Inputs (Floating Labels integration) */
            .form-floating > .form-control {
                border: 2px solid #e9ecef;
                border-radius: 10px;
                box-shadow: none;
                transition: border-color 0.3s ease, box-shadow 0.3s ease;
            }

                .form-floating > .form-control:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
                }

            .form-floating > label {
                color: #6c757d;
                font-weight: 500;
            }

            /* Custom Checkbox */
            .form-check-input:checked {
                background-color: #0d6efd;
                border-color: #0d6efd;
            }

            /* Enhanced Button */
            .btn-login {
                background-color: #0d6efd;
                color: white;
                font-weight: 600;
                padding: 0.875rem;
                border-radius: 10px;
                width: 100%;
                border: none;
                margin-top: 1.5rem;
                font-size: 1.05rem;
                transition: all 0.2s ease;
            }

                .btn-login:hover {
                    background-color: #0b5ed7;
                    transform: translateY(-1px);
                    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
                }

                .btn-login:active {
                    transform: translateY(1px);
                    box-shadow: none;
                }

            /* Hide banner on mobile to keep focus on form */
            @@media (max-width: 767.98px) {
                .login-banner {
                    display: none !important;
                }
            }
    </style>
</head>
<body>
    <div class="container-fluid login-container">
        <div class="row g-0 min-vh-100">

            <!-- Left Panel (Banner) -->
            <div class="col-md-5 col-lg-6 login-banner d-none d-md-flex">
                <div>
                    <h1 class="banner-title">ResROMS</h1>
                    <p class="banner-subtitle">Streamline your workflow, manage your resources, and accelerate your productivity with our modern platform.</p>
                </div>
            </div>

            <!-- Right Panel (Form) -->
            <div class="col-12 col-md-7 col-lg-6 login-form-wrapper">
                <div class="login-card">
                    <h2 class="login-heading">Welcome back</h2>
                    <p class="login-subheading">Enter your details to access your account.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                        <!-- Floating Label Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" id="floatingInput" placeholder="name@example.com" autocomplete="username" />
                            <label asp-for="Input.Email" for="floatingInput">Email address</label>
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Floating Label Password -->
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Password" class="form-control" id="floatingPassword" placeholder="Password" autocomplete="current-password" />
                            <label asp-for="Input.Password" for="floatingPassword">Password</label>
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Options Row -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" id="rememberMe" />
                                <label asp-for="Input.RememberMe" class="form-check-label text-muted" for="rememberMe" style="font-size: 0.95rem;">
                                    Remember for 30 days
                                </label>
                            </div>
                            <a href="#" class="text-decoration-none" style="font-size: 0.95rem; font-weight: 500; color: #0d6efd;">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn btn-login">Sign In</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Client-side validation -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>