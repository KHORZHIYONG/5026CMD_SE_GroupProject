@page
@model ResROMS.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResROMS</title>

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <!-- Google Fonts: 'Outfit' for a very modern, geometric look -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Outfit', sans-serif;
                /* Ambient Restaurant Background with a dark overlay */
                background: linear-gradient(rgba(18, 20, 24, 0.7), rgba(18, 20, 24, 0.8)), url('https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?auto=format&fit=crop&q=80&w=2000') center/cover no-repeat;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                margin: 0;
                color: #ffffff;
            }

            /* Brand Area */
            .brand-header {
                text-align: center;
                margin-bottom: 2rem;
            }

            .brand-logo-text {
                font-size: 2.5rem;
                font-weight: 700;
                letter-spacing: -1px;
                background: linear-gradient(135deg, #ff7b00, #ffea00);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 0.5rem;
            }

            .brand-tagline {
                font-weight: 300;
                color: #d1d5db;
                font-size: 1.1rem;
            }

            /* Glassmorphism Card */
            .login-card {
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 20px;
                box-shadow: 0 25px 45px rgba(0, 0, 0, 0.2);
                padding: 45px;
                width: 100%;
                max-width: 420px;
            }

            /* Custom Inputs */
            .form-label {
                font-size: 0.9rem;
                font-weight: 500;
                color: #e5e7eb;
                margin-bottom: 8px;
            }

            .input-wrapper {
                display: flex;
                align-items: center;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 12px;
                padding: 4px 15px;
                transition: all 0.3s ease;
            }
                /* Fix the white background on click/focus */
                .input-wrapper input:focus {
                    background-color: transparent !important;
                    color: #ffffff !important;
                    box-shadow: none !important;
                    outline: none !important;
                }

                /* Fix browser autofill turning the input white/yellow */
                .input-wrapper input:-webkit-autofill,
                .input-wrapper input:-webkit-autofill:hover,
                .input-wrapper input:-webkit-autofill:focus,
                .input-wrapper input:-webkit-autofill:active {
                    -webkit-text-fill-color: #ffffff !important;
                    transition: background-color 5000s ease-in-out 0s;
                }

                .input-wrapper:focus-within {
                    background: rgba(255, 255, 255, 0.1);
                    border-color: #ff7b00;
                    box-shadow: 0 0 0 4px rgba(255, 123, 0, 0.15);
                }

                .input-wrapper i {
                    color: #9ca3af;
                    font-size: 1.2rem;
                    margin-right: 12px;
                }

                .input-wrapper input {
                    background: transparent;
                    border: none;
                    box-shadow: none !important;
                    padding: 12px 0;
                    font-size: 1rem;
                    color: #ffffff;
                    width: 100%;
                }

                    .input-wrapper input::placeholder {
                        color: #6b7280;
                    }

            /* Appetizing Button */
            .btn-login {
                background: linear-gradient(135deg, #e85d04, #dc2f02);
                color: white;
                font-weight: 600;
                font-size: 1.1rem;
                padding: 14px;
                border-radius: 12px;
                width: 100%;
                border: none;
                margin-top: 20px;
                margin-bottom: 20px;
                box-shadow: 0 10px 20px rgba(220, 47, 2, 0.3);
                transition: all 0.2s ease;
            }

                .btn-login:hover {
                    background: linear-gradient(135deg, #f48c06, #e85d04);
                    transform: translateY(-2px);
                    box-shadow: 0 12px 25px rgba(220, 47, 2, 0.4);
                    color: white;
                }

            /* Links */
            .card-links {
                display: flex;
                justify-content: space-between;
                font-size: 0.9rem;
                font-weight: 400;
            }

                .card-links a {
                    color: #fca311;
                    text-decoration: none;
                    transition: color 0.2s;
                }

                    .card-links a:hover {
                        color: #ffb703;
                        text-decoration: underline;
                    }

            /* Responsive styling */
            @@media (max-width: 480px) {
                .login-card {
                    background: rgba(20, 20, 20, 0.85); /* Solidify on mobile for readability */
                    backdrop-filter: none;
                    border: none;
                    padding: 30px 20px;
                    border-radius: 0;
                    min-height: 100vh;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                }

                body {
                    background: #121418; /* Remove image on small screens to save bandwidth/distraction */
                }

                .brand-header {
                    margin-top: -50px;
                }
            }
    </style>
</head>
<body>

    <div class="brand-header">
        <div class="brand-logo-text">ResROMS</div>
        <div class="brand-tagline">Restaurant Management System</div>
    </div>

    <div class="login-card">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small fw-bold"></div>

            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label">Email Address</label>
                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" class="form-control" placeholder="manager@restaurant.com" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Email" class="text-warning small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <div class="input-wrapper">
                    <i class="bi bi-shield-lock"></i>
                    <input asp-for="Input.Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.Password" class="text-warning small mt-1 d-block"></span>
            </div>

            <input type="hidden" asp-for="Input.RememberMe" value="true" />

            <button type="submit" class="btn btn-login">Access Dashboard</button>

            <div class="card-links">
                <a href="#">Contact Support</a>
                <a href="#">Forgot password?</a>
            </div>
        </form>
    </div>

    <!-- Client-side validation scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>